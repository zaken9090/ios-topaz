+/* ---------------------------------------------------------------- log dump (lavender) */
+
+/*
+ * gpudiag=3: after gpudiag_secs (default 90) the console log (bsd/dev/sweet_ufs.c keeps the last
+ * 4 MiB of it) is shown on the screen a page at a time, only the lines that hold one of the
+ * words of logdump_grep (comma separated; default "|backboardd|,RedwoodGPU,TopazGPU,topaz"):
+ * the first page of them, then the latest ones, each page for logdump_page seconds (default 20,
+ * drawn again every two seconds, since other programs keep writing), the latest last, followed
+ * by the gpudiag=2 panic. With sweetfb_mdp=0 sweetfb_noconsole=0 there is nothing to read the
+ * log by but a camera.
+ */
+extern "C" uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern "C" uint64_t sweet_log_position(void);
+
+#define LD_COLS         71              /* characters in a row of the console on this panel */
+#define LD_ROWS         54              /* rows a page may take (the panic's text comes after the last) */
+#define LD_LINE         (2 * LD_COLS)   /* a line is cut after two rows */
+#define LD_PAGES        5
+
+static char ld_grep[192];
+static char ld_chunk[2048];
+
+static bool
+ld_match(const char *line, unsigned len)
+{
+	for (const char *t = ld_grep; *t != 0;) {
+		const char *end = t;
+		while (*end != 0 && *end != ',') {
+			end++;
+		}
+		unsigned n = (unsigned)(end - t);
+		for (unsigned i = 0; n != 0 && i + n <= len; i++) {
+			if (memcmp(line + i, t, n) == 0) {
+				return true;
+			}
+		}
+		t = *end == ',' ? end + 1 : end;
+	}
+	return false;
+}
+
+static unsigned
+ld_rows(unsigned len)
+{
+	if (len > LD_LINE) {
+		len = LD_LINE;
+	}
+	return len == 0 ? 1 : (len + LD_COLS - 1) / LD_COLS;
+}
+
+/*
+ * Every matching line of the log in [from, to): fn(index, line, len, ctx). The line is cut at
+ * LD_LINE characters; control characters become spaces.
+ */
+static unsigned
+ld_scan(uint64_t from, uint64_t to, void (*fn)(unsigned, const char *, unsigned, void *), void *ctx)
+{
+	char line[LD_LINE + 1];
+	unsigned len = 0, matches = 0;
+	uint64_t pos = from;
+	bool over = false;
+
+	while (pos < to) {
+		uint32_t want = (uint32_t)(to - pos < sizeof(ld_chunk) ? to - pos : sizeof(ld_chunk));
+		uint32_t got = sweet_log_copy(&pos, ld_chunk, want);
+
+		if (got == 0) {
+			break;
+		}
+		for (uint32_t i = 0; i < got; i++) {
+			char c = ld_chunk[i];
+
+			if (c == '\n') {
+				line[len] = 0;
+				if (len != 0 && ld_match(line, len)) {
+					fn(matches++, line, len, ctx);
+				}
+				len = 0;
+				over = false;
+			} else if (len < LD_LINE && !over) {
+				line[len++] = (c < 0x20 || c > 0x7e) ? ' ' : c;
+			} else {
+				over = true;
+			}
+		}
+	}
+	return matches;
+}
+
+struct ld_count {
+	uint8_t *rows;
+	unsigned max;
+};
+
+static void
+ld_count_line(unsigned index, __unused const char *line, unsigned len, void *ctx)
+{
+	struct ld_count *c = (struct ld_count *)ctx;
+
+	if (index < c->max) {
+		c->rows[index] = (uint8_t)ld_rows(len);
+	}
+}
+
+struct ld_print {
+	unsigned first, last;           /* lines [first, last) */
+};
+
+static void
+ld_print_line(unsigned index, const char *line, unsigned len, void *ctx)
+{
+	struct ld_print *p = (struct ld_print *)ctx;
+
+	if (index >= p->first && index < p->last) {
+		IOLog("%.*s\n", (int)len, line);
+	}
+}
+
+static void
+topaz_logdump(void)
+{
+	uint32_t page_secs = 20;
+	uint64_t to = sweet_log_position(), from = to > (4u << 20) ? to - (4u << 20) : 0;
+	struct ld_count count;
+	unsigned total, pages = 0, start[LD_PAGES + 1];
+
+	if (!PE_parse_boot_argn("logdump_grep", ld_grep, sizeof(ld_grep))) {
+		strlcpy(ld_grep, "|backboardd|,RedwoodGPU,TopazGPU,topaz", sizeof(ld_grep));
+	}
+	PE_parse_boot_argn("logdump_page", &page_secs, sizeof(page_secs));
+	count.max = 65536;
+	count.rows = (uint8_t *)IOMallocData(count.max);
+	if (count.rows == NULL) {
+		IOLog("LOGDUMP: no memory\n");
+		return;
+	}
+	total = ld_scan(from, to, ld_count_line, &count);
+	if (total > count.max) {
+		total = count.max;
+	}
+	/* the first page: from the first line on */
+	unsigned i = 0, rows = 0;
+	start[pages++] = 0;
+	while (i < total && rows + count.rows[i] <= LD_ROWS - 1) {
+		rows += count.rows[i++];
+	}
+	unsigned first_end = i;
+	/* the latest pages: back from the last line */
+	unsigned j = total, budget = (LD_PAGES - 1) * (LD_ROWS - 1);
+	rows = 0;
+	while (j > first_end && rows + count.rows[j - 1] <= budget) {
+		rows += count.rows[--j];
+	}
+	/* cut [j, total) into pages, forwards */
+	unsigned k = j;
+	start[pages] = first_end;
+	if (j != first_end) {
+		start[pages] = j;       /* (a gap: lines between the pages are not shown) */
+	}
+	while (k < total && pages < LD_PAGES) {
+		rows = 0;
+		start[pages++] = k;
+		while (k < total && rows + count.rows[k] <= LD_ROWS - 1) {
+			rows += count.rows[k++];
+		}
+	}
+	start[pages] = total;
+	/* (the first page ends at first_end, the others where the next begins) */
+	for (unsigned p = 0; p < pages; p++) {
+		struct ld_print print = { start[p], p == 0 ? first_end : start[p + 1] };
+
+		for (uint32_t t = 0; t < page_secs; t += 2) {
+			IOLog("==== LOG PAGE %u/%u: lines %u-%u of %u matching '%s' ====\n", p + 1, pages, print.first + 1,
+			    print.last, total, ld_grep);
+			ld_scan(from, to, ld_print_line, &print);
+			if (p == pages - 1) {
+				break;                  /* the last page stays: the panic follows it */
+			}
+			IOSleep(2000);
+		}
+	}
+	IOFreeData(count.rows, count.max);
+}
+
 /* ---------------------------------------------------------------- start */
 
