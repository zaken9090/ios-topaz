From 3952cd4bfbd583a84fbe800654e61ab676da663a Mon Sep 17 00:00:00 2001
From: zaken9090 <zaken9090@users.noreply.github.com>
Date: Sat, 21 Nov 2026 16:11:55 +0200
Subject: [PATCH] lavender: LVCLK - real BIMC (DDR) clock from the GCC
 frequency counter before/after the vote; the vote goes to the sleep set too
 (lv_ddr_set); bimc kHz in the LVGPU line

---
 iokit/Kernel/arm/TopazAdreno.cpp | 59 +++++++++++++++++++++++++++++---
 1 file changed, 55 insertions(+), 4 deletions(-)

diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
index 53f28ac..5eea997 100644
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -137,6 +137,44 @@ static inline void wr(volatile uint8_t *b, uint32_t o, uint32_t v)
 static inline void rmw(volatile uint8_t *b, uint32_t o, uint32_t clr, uint32_t set) { wr(b, o, (rd(b, o) & ~clr) | set); }
 static inline void gpu_wr(uint32_t reg, uint32_t v) { wr(gpu, 4 * reg, v); }
 static inline uint32_t gpu_rd(uint32_t reg) { return rd(gpu, 4 * reg); }
+
+/*
+ * lavender: the GCC frequency counter (debug mux 0x62000, as clk-debug.c / gcc-sdm660 debug mux):
+ * what a clock really runs at, in kHz (0: off or no answer). sel: bimc_clk 0x19d, snoc 0x000,
+ * cnoc 0x00e, gcc_bimc_gfx 0x0ac, gcc_gpu_bimc_gfx 0x13f. Counts CXO/4 ticks: 1 ms, then 14 ms.
+ */
+static uint32_t
+lv_count(uint32_t ticks)
+{
+	int n;
+	wr(gcc, 0x62004, ticks);
+	for (n = 0; n < 20000 && (rd(gcc, 0x62008) & (1u << 25)) != 0; n++) {
+		IODelay(1);
+	}
+	wr(gcc, 0x62004, (1u << 20) | ticks);
+	for (n = 0; n < 40000 && (rd(gcc, 0x62008) & (1u << 25)) == 0; n++) {
+		IODelay(1);
+	}
+	if ((rd(gcc, 0x62008) & (1u << 25)) == 0) {
+		return 0;
+	}
+	return rd(gcc, 0x62008) & 0x1ffffff;
+}
+
+static uint32_t
+lv_clk_khz(uint32_t sel)
+{
+	if (gcc == NULL) {
+		return 0;
+	}
+	rmw(gcc, 0x62000, 0x3ffu | (0xfu << 12), (sel & 0x3ff) | (1u << 16));
+	rmw(gcc, 0x43008, 0, 1);                        /* gcc_xo_div4 branch */
+	uint64_t shortc = lv_count(0x1000), full = lv_count(0x10000);
+	if (full == 0 || full == shortc) {
+		return 0;
+	}
+	return (uint32_t)(((full * 10) + 15) * 4800000ull / ((0x10000ull * 10) + 35) / 1000);
+}
 static inline void gpu_wr64(uint32_t reg, uint64_t v) { gpu_wr(reg, (uint32_t)v); gpu_wr(reg + 1, (uint32_t)(v >> 32)); }
 
 static bool
@@ -617,11 +655,24 @@ power_up(void)
 	 */
 	{
 		uint32_t khz = 0;
+		uint32_t before = lv_clk_khz(0x19d);
 		if (PE_parse_boot_argn("lv_ddr_khz", &khz, sizeof(khz)) && khz != 0) {
-			bool ok = topaz_rpm_write(0, 0x326b6c63u /* clk2 */, 0, 0x007a484bu /* KHz */, khz);
+			/* lv_ddr_set: 1 active set, 2 sleep set (clk-smd-rpm votes both for bimc_clk), 3 both */
+			uint32_t sets = 3;
+			PE_parse_boot_argn("lv_ddr_set", &sets, sizeof(sets));
+			bool ok = true;
+			if (sets & 2) {
+				ok &= topaz_rpm_write(1, 0x326b6c63u /* clk2 */, 0, 0x007a484bu /* KHz */, khz);
+			}
+			if (sets & 1) {
+				ok &= topaz_rpm_write(0, 0x326b6c63u /* clk2 */, 0, 0x007a484bu /* KHz */, khz);
+			}
 			ddr_khz = ok ? khz : 0;
-			IOLog("TopazGPU: DDR %u kHz %s (RPM status %d)\n", khz, ok ? "voted" : "NOT voted", topaz_rpm_status);
+			IODelay(2000);
+			IOLog("TopazGPU: DDR %u kHz %s sets %u (RPM status %d)\n", khz, ok ? "voted" : "NOT voted", sets, topaz_rpm_status);
 		}
+		IOLog("LVCLK bimc %u kHz before the vote, %u after; snoc %u cnoc %u bimc_gfx %u gpu_bimc_gfx %u kHz\n",
+		    before, lv_clk_khz(0x19d), lv_clk_khz(0x000), lv_clk_khz(0x00e), lv_clk_khz(0x0ac), lv_clk_khz(0x13f));
 	}
 	/* gfx3d from GPLL0 (600 MHz): /2 = 300 (default) or /1 = 600; gpu_mhz=19: XO */
 	if (core_mhz < 300) {
@@ -1599,8 +1650,8 @@ topaz_osd_sampler(__unused void *param, __unused wait_result_t wr_)
 					/* AXI beats of 16 bytes, MB/s over the 5 s, and per second the core was busy */
 					uint64_t rdmb = (vr - last_rd) * 16 / 5 / 1000000, wrmb = (vw - last_wr) * 16 / 5 / 1000000;
 					if (topaz_osd_gpu_busy != 0 || core != 0) {
-						IOLog("LVGPU clock %u MHz core busy %u%% (pending %u%%) DDR read %llu MB/s write %llu MB/s (%llu MB/s busy)\n",
-						    mhz, core, topaz_osd_gpu_busy, rdmb, wrmb, core ? (rdmb + wrmb) * 100 / core : 0);
+						IOLog("LVGPU clock %u MHz core busy %u%% (pending %u%%) DDR read %llu MB/s write %llu MB/s (%llu MB/s busy) bimc %u kHz\n",
+						    mhz, core, topaz_osd_gpu_busy, rdmb, wrmb, core ? (rdmb + wrmb) * 100 / core : 0, lv_clk_khz(0x19d));
 					}
 				}
 				if (secs % 5 == 0 || last_ao == 0) {
-- 
