From a97c636db455ada91e3ebeedace069df360cd45b Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Sat, 21 Nov 2026 01:35:02 +0200
Subject: [PATCH] lavender: arena chunks only above 4 GiB (below, Mesa's
 buffers ran the GPU pool dry and backboardd crashed); USB: no SETUP 0.3 s
 after a bus reset re-arms ep0 first, the controller restart (a replug for
 Windows) only after 2 s; no Ethernet frames on bulk IN in WinUSB mode

---
 bsd/dev/sweet_usb.c               | 36 +++++++++++++++++++++++++------
 iokit/Kernel/arm/SweetSurface.cpp | 27 ++++++++++++++++++++---
 2 files changed, 53 insertions(+), 10 deletions(-)

diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index e4846ef..614612b 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -221,6 +221,7 @@ static struct {
 	bool        tx_busy;
 	uint64_t    tx_since;       /* lavender: mach_absolute_time() the TX transfer started */
 	uint64_t    reset_at;       /* lavender: last bus reset, 0 once a SETUP followed it */
+	bool        reset_rearmed;  /* lavender: ep0 SETUP armed again once after that reset */
 	uint32_t    restarts;
 	bool        rx_active;      /* lavender: a transfer is armed on bulk OUT */
 	bool        rx_rearm;       /* lavender: arming it failed: ud_thread retries */
@@ -1662,7 +1663,8 @@ static errno_t
 ud_if_output(ifnet_t ifp, mbuf_t m)
 {
 	lck_mtx_lock(ud.lock);
-	if (ud.txq_count == UD_TXQ || !ud.configured) {
+	/* lavender: in WinUSB mode bulk IN carries the log and screenshots: no Ethernet frames among them */
+	if (ud.txq_count == UD_TXQ || !ud.configured || ud_winusb()) {
 		lck_mtx_unlock(ud.lock);
 		mbuf_freem(m);
 		ifnet_stat_increment_out(ifp, 0, 0, 1);
@@ -1785,6 +1787,7 @@ ud_event(uint32_t ev)
 			    ud.tx_frames, ud.rx_frames);
 			ud_unconfigure();
 			ud.reset_at = mach_absolute_time() | 1;
+			ud.reset_rearmed = false;
 			/*
 			 * lavender: a reset in the middle of a control transfer left ep0 without its
 			 * SETUP transfer, and the device answered nothing until a reboot ("USB device
@@ -1873,13 +1876,32 @@ ud_event(uint32_t ev)
 static void
 ud_watchdog(void)
 {
-	uint64_t now = mach_absolute_time(), s10, s2;
-	bool tx_stuck, reset_dead;
+	uint64_t now = mach_absolute_time(), s10, s2, s03;
 
 	nanoseconds_to_absolutetime(10 * NSEC_PER_SEC, &s10);
-	nanoseconds_to_absolutetime(300 * NSEC_PER_MSEC, &s2);     /* (2 s: Windows said "not recognized" first) */
-	tx_stuck = ud_winusb() && ud.configured && ud.tx_busy && now - ud.tx_since > s10;
-	reset_dead = ud.reset_at != 0 && now - ud.reset_at > s2;
+	nanoseconds_to_absolutetime(2 * NSEC_PER_SEC, &s2);
+	nanoseconds_to_absolutetime(300 * NSEC_PER_MSEC, &s03);
+	/*
+	 * lavender: a bus reset with no SETUP after it: first, at 0.3 s, ep0 alone is set up again
+	 * (EndTransfer on both directions, SETUP armed anew) - the PC's port reset then ends in a
+	 * normal enumeration, which Windows does without a disconnect (no sound, no "not
+	 * recognized"). Only if that brings nothing in 2 s is the whole controller restarted, which
+	 * the PC sees as the device unplugged and plugged in.
+	 */
+	if (ud.reset_at != 0 && !ud.reset_rearmed && now - ud.reset_at > s03) {
+		ud.reset_rearmed = true;
+		printf("SWEET USB: no SETUP 0.3 s after reset: ep0 armed again (state %u, DSTS 0x%08x, DCFG 0x%08x)\n",
+		    ud.state, dwc_rd(DSTS), dwc_rd(DCFG));
+		ud_epcmd(0, 8 | (1u << 11), 0, 0, 0);
+		ud_epcmd(1, 8 | (1u << 11), 0, 0, 0);
+		delay(100);
+		ud_epcmd(0, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30), (1u << 8) | (1u << 10) | (0u << 25), 0);
+		ud_epcmd(1, DEPCMD_SETEPCONFIG, (0u << 1) | (64u << 3) | (2u << 30), (1u << 8) | (1u << 10) | (1u << 25), 0);
+		ud_start_setup();
+		return;
+	}
+	bool tx_stuck = ud_winusb() && ud.configured && ud.tx_busy && now - ud.tx_since > s10;
+	bool reset_dead = ud.reset_at != 0 && now - ud.reset_at > s2;
 	if (!tx_stuck && !reset_dead) {
 		return;
 	}
@@ -1887,7 +1909,7 @@ ud_watchdog(void)
 	volatile uint32_t *tt = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
 	volatile uint32_t *t0 = (volatile uint32_t *)(ud.dma + UD_TRB_OUT);
 	printf("SWEET USB: BLACKBOX %s: restart %u, ep0 state %u, tx_busy %d rx_active %d, tx %llu rx %llu, "
-	    "events %u evt_pos 0x%x GEVNTCOUNT %u\n", tx_stuck ? "TX stuck 10 s" : "no SETUP 0.3 s after reset",
+	    "events %u evt_pos 0x%x GEVNTCOUNT %u\n", tx_stuck ? "TX stuck 10 s" : "no SETUP 2 s after reset",
 	    ud.restarts, ud.state, ud.tx_busy, ud.rx_active, ud.tx_frames, ud.rx_frames, ud.events, ud.evt_pos,
 	    dwc_rd(GEVNTCOUNT) & 0xffff);
 	printf("SWEET USB: BLACKBOX DSTS 0x%08x DCTL 0x%08x DCFG 0x%08x GSTS 0x%08x GCTL 0x%08x GUSB2PHYCFG 0x%08x "
diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index c8f7f55..83b7cfc 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -314,20 +314,41 @@ sweet_arena_fill(void)
 	if (want > SWEET_ARENA_MAX) {
 		want = SWEET_ARENA_MAX;
 	}
-	unsigned n = 0;
-	for (; n < want; n++) {
+	/*
+	 * Only chunks above 4 GiB: the GPU's own buffers (RedwoodGPU gemNew) want contiguous memory
+	 * below 4 GiB and fall back to the GPU pool; with the arena down there the pool ran out
+	 * ("the GPU pool has no 12582912 bytes left") and Mesa crashed on the failed allocation.
+	 * Chunks that come out below 4 GiB are held while more are asked for, then given back.
+	 */
+	IOBufferMemoryDescriptor *low[SWEET_ARENA_MAX];
+	unsigned n = 0, nlow = 0;
+	while (n < want) {
 		IOBufferMemoryDescriptor *m = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
 		    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous, SWEET_ARENA_CHUNK,
 		    0x0000000FFFFFC000ull);
 		if (m == NULL) {
 			break;
 		}
+		uint64_t pa = m->getPhysicalSegment(0, NULL, kIOMemoryMapperNone);
+		if (pa < 0x100000000ull) {
+			if (nlow == SWEET_ARENA_MAX) {
+				m->release();
+				break;
+			}
+			low[nlow++] = m;
+			continue;
+		}
 		sweet_arena_md[n] = m;
 		sweet_arena_va[n] = (uint8_t *)m->getBytesNoCopy();
+		n++;
+	}
+	for (unsigned i = 0; i < nlow; i++) {
+		low[i]->release();
 	}
 	sweet_arena_n = n;
 	if (want != 0) {
-		IOLog("SWEET SURF: arena: %u of %u contiguous chunks of %u MB\n", n, want, SWEET_ARENA_CHUNK >> 20);
+		IOLog("SWEET SURF: arena: %u of %u contiguous chunks of %u MB above 4 GiB (%u below given back)\n", n, want,
+		    SWEET_ARENA_CHUNK >> 20, nlow);
 	}
 }
 
-- 
2.56.0.windows.4

