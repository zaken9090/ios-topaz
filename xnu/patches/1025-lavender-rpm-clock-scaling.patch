From 91c312e31150a5acba2ccda0acb9858929d72d00 Mon Sep 17 00:00:00 2001
From: zaken9090 <zaken9090@users.noreply.github.com>
Date: Sat, 21 Nov 2026 16:21:58 +0200
Subject: [PATCH] lavender: lv_rpm_scale=1 - turn RPM clock scaling on (clk0 2
 Enab) after bus votes in both sets, so the DDR vote takes effect (BIMC stayed
 648 MHz)

---
 iokit/Kernel/arm/TopazAdreno.cpp | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
index 5eea997..c176467 100644
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -667,6 +667,32 @@ power_up(void)
 			if (sets & 1) {
 				ok &= topaz_rpm_write(0, 0x326b6c63u /* clk2 */, 0, 0x007a484bu /* KHz */, khz);
 			}
+			/*
+			 * lavender: the RPM ignores clock votes until the apps side turns clock scaling on
+			 * (clk-smd-rpm.c clk_smd_rpm_enable_scaling: clk0 id 2, key "Enab" = 1, sleep then
+			 * active set): BIMC stayed at 648 MHz whatever was voted. Once on, a clock nobody
+			 * votes for may drop, so first the buses Android's msm_bus keeps up get votes in both
+			 * sets (snoc, cnoc, cnoc_periph, mmss NoC AXI for the display, aggre2). lv_rpm_scale=1.
+			 */
+			uint32_t scale = 0;
+			PE_parse_boot_argn("lv_rpm_scale", &scale, sizeof(scale));
+			if (scale != 0 && ok) {
+				static const struct { uint32_t type, id, khz; } bus[] = {
+					{ 0x316b6c63u /* clk1 */, 1, 200000 },      /* snoc */
+					{ 0x316b6c63u /* clk1 */, 2, 100000 },      /* cnoc */
+					{ 0x316b6c63u /* clk1 */, 0, 50000 },       /* cnoc_periph */
+					{ 0x69786d6du /* mmxi */, 0, 320000 },      /* mmssnoc_axi */
+					{ 0x616b6c63u /* clka */, 2, 150000 },      /* aggre2_noc */
+				};
+				bool bok = true;
+				for (unsigned i = 0; i < sizeof(bus) / sizeof(bus[0]); i++) {
+					bok &= topaz_rpm_write(1, bus[i].type, bus[i].id, 0x007a484bu, bus[i].khz);
+					bok &= topaz_rpm_write(0, bus[i].type, bus[i].id, 0x007a484bu, bus[i].khz);
+				}
+				bool sok = bok && topaz_rpm_write(1, 0x306b6c63u /* clk0 */, 2, 0x62616e45u /* Enab */, 1) &&
+				    topaz_rpm_write(0, 0x306b6c63u /* clk0 */, 2, 0x62616e45u /* Enab */, 1);
+				IOLog("TopazGPU: bus votes %s, RPM clock scaling %s\n", bok ? "ok" : "FAILED", sok ? "ON" : "not on");
+			}
 			ddr_khz = ok ? khz : 0;
 			IODelay(2000);
 			IOLog("TopazGPU: DDR %u kHz %s sets %u (RPM status %d)\n", khz, ok ? "voted" : "NOT voted", sets, topaz_rpm_status);
-- 
