diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 30c0259..c8f7f55 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -34,6 +34,7 @@
 #if defined(SWEET)
 #include <IOKit/IOService.h>
 #include <IOKit/IOUserClient.h>
+#include <IOKit/IOSubMemoryDescriptor.h>
 #include <IOKit/IOKitKeys.h>
 #include <IOKit/IOLib.h>
 #include <mach/mach_time.h>
@@ -255,6 +256,182 @@ sweet_res_give(IOMemoryDescriptor *md)
 	return kept;
 }
 
+/*
+ * lavender: the contiguous arena. With the GPU's SMMU passing addresses through (gpu_identity=1)
+ * the GPU reads a surface where it is only if the surface is physically contiguous; by the time
+ * SpringBoard and the wallpaper make theirs, RAM is in pieces (0-2 of the 10 screen buffers above
+ * set aside, 291 surfaces copied into textures and summed every frame: 15+ % of backboardd, and
+ * 11 MB glTexSubImage2D refills). So at IOSurface root start, while RAM is still whole, chunks of
+ * 32 MB (cached kernel memory, like the contiguous surfaces that already shared) are set aside
+ * and the GPU-shareable surfaces (4 bytes a pixel, rows 64-byte aligned, 64 KB or more) are cut
+ * from them in 16 KB units, with the 64 guard rows. boot-arg sweetsurf_arena=MB (default 256 with
+ * gpu=1; 0: off). A chunk part freed while a mapping still holds it waits (sweet_arena_sweep).
+ */
+#define SWEET_ARENA_CHUNK       (32u << 20)
+#define SWEET_ARENA_UNIT        (16u << 10)
+#define SWEET_ARENA_UNITS       (SWEET_ARENA_CHUNK / SWEET_ARENA_UNIT)  /* 2048 */
+#define SWEET_ARENA_MAX         24
+#define SWEET_ARENA_WAIT        64
+static IOBufferMemoryDescriptor *sweet_arena_md[SWEET_ARENA_MAX];
+static uint8_t                  *sweet_arena_va[SWEET_ARENA_MAX];
+static uint64_t                  sweet_arena_map[SWEET_ARENA_MAX][SWEET_ARENA_UNITS / 64];     /* bit set: used */
+static uint32_t                  sweet_arena_used;     /* units, sweet_surface_lock */
+static unsigned                  sweet_arena_n;
+static struct {
+	IOMemoryDescriptor *md;
+	int chunk;
+	uint32_t first, units;
+} sweet_arena_wait[SWEET_ARENA_WAIT];                  /* sweet_surface_lock */
+
+static void
+sweet_arena_mark(int c, uint32_t first, uint32_t units, bool used)
+{
+	for (uint32_t u = first; u < first + units; u++) {
+		if (used) {
+			sweet_arena_map[c][u / 64] |= 1ull << (u % 64);
+		} else {
+			sweet_arena_map[c][u / 64] &= ~(1ull << (u % 64));
+		}
+	}
+	sweet_arena_used = used ? sweet_arena_used + units : sweet_arena_used - units;
+}
+
+static void
+sweet_arena_fill(void)
+{
+	static bool filled;
+	uint32_t gpu = 0, mb = 0;
+
+	if (filled) {
+		return;
+	}
+	filled = true;
+	if (PE_parse_boot_argn("gpu", &gpu, sizeof(gpu)) && gpu != 0) {
+		mb = 256;
+	}
+	PE_parse_boot_argn("sweetsurf_arena", &mb, sizeof(mb));
+	unsigned want = mb / (SWEET_ARENA_CHUNK >> 20);
+	if (want > SWEET_ARENA_MAX) {
+		want = SWEET_ARENA_MAX;
+	}
+	unsigned n = 0;
+	for (; n < want; n++) {
+		IOBufferMemoryDescriptor *m = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared | kIOMemoryPhysicallyContiguous, SWEET_ARENA_CHUNK,
+		    0x0000000FFFFFC000ull);
+		if (m == NULL) {
+			break;
+		}
+		sweet_arena_md[n] = m;
+		sweet_arena_va[n] = (uint8_t *)m->getBytesNoCopy();
+	}
+	sweet_arena_n = n;
+	if (want != 0) {
+		IOLog("SWEET SURF: arena: %u of %u contiguous chunks of %u MB\n", n, want, SWEET_ARENA_CHUNK >> 20);
+	}
+}
+
+/* Lock held: parts freed while held go back once only the arena holds them. */
+static void
+sweet_arena_sweep_locked(void)
+{
+	for (unsigned i = 0; i < SWEET_ARENA_WAIT; i++) {
+		if (sweet_arena_wait[i].md != NULL && sweet_arena_wait[i].md->getRetainCount() == 1) {
+			sweet_arena_wait[i].md->release();
+			sweet_arena_wait[i].md = NULL;
+			sweet_arena_mark(sweet_arena_wait[i].chunk, sweet_arena_wait[i].first, sweet_arena_wait[i].units, false);
+		}
+	}
+}
+
+/* Contiguous memory of size bytes from the arena for s, or NULL. */
+static IOMemoryDescriptor *
+sweet_arena_take(SweetSurface *s, uint64_t size)
+{
+	uint32_t units = (uint32_t)((size + SWEET_ARENA_UNIT - 1) / SWEET_ARENA_UNIT);
+	int chunk = -1;
+	uint32_t first = 0;
+
+	if (sweet_arena_n == 0 || units == 0 || units > SWEET_ARENA_UNITS) {
+		return NULL;
+	}
+	IOLockLock(sweet_surface_lock);
+	sweet_arena_sweep_locked();
+	for (unsigned c = 0; c < sweet_arena_n && chunk < 0; c++) {
+		uint32_t run = 0;
+		for (uint32_t u = 0; u < SWEET_ARENA_UNITS; u++) {
+			if ((u % 64) == 0 && sweet_arena_map[c][u / 64] == ~0ull) {
+				run = 0;
+				u += 63;
+				continue;
+			}
+			if (sweet_arena_map[c][u / 64] & (1ull << (u % 64))) {
+				run = 0;
+				continue;
+			}
+			if (++run == units) {
+				chunk = (int)c;
+				first = u + 1 - units;
+				break;
+			}
+		}
+	}
+	if (chunk >= 0) {
+		sweet_arena_mark(chunk, first, units, true);
+	}
+	IOLockUnlock(sweet_surface_lock);
+	if (chunk < 0) {
+		static uint32_t told;
+		if (told++ < 4) {
+			IOLog("SWEET SURF: arena full (%u of %u units used): %llu bytes from elsewhere\n", sweet_arena_used,
+			    sweet_arena_n * SWEET_ARENA_UNITS, size);
+		}
+		return NULL;
+	}
+	IOMemoryDescriptor *md = IOSubMemoryDescriptor::withSubRange(sweet_arena_md[chunk],
+	    (IOByteCount)first * SWEET_ARENA_UNIT, (IOByteCount)units * SWEET_ARENA_UNIT, kIODirectionInOut);
+	if (md == NULL) {
+		IOLockLock(sweet_surface_lock);
+		sweet_arena_mark(chunk, first, units, false);
+		IOLockUnlock(sweet_surface_lock);
+		return NULL;
+	}
+	s->arenaChunk = chunk;
+	s->arenaFirst = first;
+	s->arenaUnits = units;
+	return md;
+}
+
+/* s's arena part back (now, or once nobody else holds it); takes s's reference on the memory. */
+static void
+sweet_arena_give(SweetSurface *s)
+{
+	IOMemoryDescriptor *md = s->memory;
+	bool kept = false;
+
+	s->memory = NULL;
+	IOLockLock(sweet_surface_lock);
+	if (md->getRetainCount() == 1) {
+		md->release();
+		sweet_arena_mark(s->arenaChunk, s->arenaFirst, s->arenaUnits, false);
+		kept = true;
+	}
+	for (unsigned i = 0; i < SWEET_ARENA_WAIT && !kept; i++) {
+		if (sweet_arena_wait[i].md == NULL) {
+			sweet_arena_wait[i].md = md;
+			sweet_arena_wait[i].chunk = s->arenaChunk;
+			sweet_arena_wait[i].first = s->arenaFirst;
+			sweet_arena_wait[i].units = s->arenaUnits;
+			kept = true;
+		}
+	}
+	IOLockUnlock(sweet_surface_lock);
+	if (!kept) {
+		md->release();                  /* (the units stay used: leaked rather than shared twice) */
+	}
+	s->arenaChunk = -1;
+}
+
 static int
 sweet_scanout_alloc_slot(void)
 {
@@ -299,6 +476,9 @@ SweetSurface::free()
 	if (wrapped && memory != NULL) {
 		memory->complete();
 	}
+	if (arenaChunk >= 0 && memory != NULL) {
+		sweet_arena_give(this);
+	}
 	if (!wrapped && !gpuPool && memory != NULL && sweet_res_give(memory)) {
 		memory = NULL;
 	}
@@ -316,6 +496,9 @@ SweetSurface::kernelAddress()
 	if (buffer != NULL) {
 		return (uintptr_t)buffer->getBytesNoCopy();
 	}
+	if (arenaChunk >= 0 && memory != NULL) {
+		return (uintptr_t)(sweet_arena_va[arenaChunk] + (uint64_t)arenaFirst * SWEET_ARENA_UNIT);
+	}
 	IOLockLock(sweet_surface_lock);
 	if (kernelMap == NULL && memory != NULL) {
 		kernelMap = memory->map(scanoutPhys || wrapped ? kIOMapDefaultCache : kIOMapWriteCombineCache);
@@ -670,6 +853,7 @@ IOCoreSurfaceRoot::start(IOService *provider)
 		return false;
 	}
 	sweet_surface_init_lock();
+	sweet_arena_fill();
 	setProperty(kIOUserClientClassKey, "IOSurfaceRootUserClient");
 	registerService();
 	IOLog("SWEET SURF: IOCoreSurfaceRoot registered\n");
@@ -1067,6 +1251,27 @@ IOSurfaceRootUserClient::create(IOExternalMethodArguments *args)
 			}
 		}
 	}
+	/* lavender: GPU-shareable surfaces from the contiguous arena (see sweet_arena_fill) */
+	if (ret == kIOReturnSuccess && s->memory == NULL && sweet_arena_n != 0 && s->bytesPerElement == 4 &&
+	    s->planeCount <= 1 && s->elementWidth == 1 && s->elementHeight == 1 && (s->bytesPerRow & 63) == 0 &&
+	    s->allocSize >= (64u << 10)) {
+		uint64_t take = sweet_round_upage(s->allocSize + 64ull * s->bytesPerRow);
+		IOMemoryDescriptor *md = sweet_arena_take(s, take);
+		if (md != NULL) {
+			s->memory = md;
+			s->mapCache = kIOMapDefaultCache;
+			bzero((void *)s->kernelAddress(), s->allocSize);
+			if (!sweet_surface_publish(s)) {
+				ret = kIOReturnNoResources;
+			}
+			static uint32_t arena_told;
+			if (arena_told++ < 24) {
+				IOLog("SWEET SURF: arena: surface %u %ux%u bpr %u (%llu KB) at chunk %d unit %u (%u of %u used)\n",
+				    s->id, s->width, s->height, s->bytesPerRow, take >> 10, s->arenaChunk, s->arenaFirst,
+				    sweet_arena_used, sweet_arena_n * SWEET_ARENA_UNITS);
+			}
+		}
+	}
 	if (ret == kIOReturnSuccess && s->memory == NULL) {
 		IOBufferMemoryDescriptor *mem = NULL;
 		if ((uint64_t)OSAddAtomic64(s->allocSize, (volatile SInt64 *)&sweet_surface_wired) +
diff --git a/iokit/Kernel/arm/SweetSurface.h b/iokit/Kernel/arm/SweetSurface.h
index 5b74320..0f1533a 100644
--- a/iokit/Kernel/arm/SweetSurface.h
+++ b/iokit/Kernel/arm/SweetSurface.h
@@ -48,8 +48,10 @@ public:
 	bool                      gpuPool;      /* topaz GPU: memory from the GPU pool below 4 GiB (scanoutPhys = its address) */
 	uint64_t                  poolSize;     /* bytes taken from the GPU pool (allocSize and a guard) */
 	uint32_t                  drawn;        /* topaz GPU: last submission naming this surface (RedwoodGPU.cpp) */
+	int                       arenaChunk;   /* lavender: chunk of the contiguous arena the pixels are in, or -1 */
+	uint32_t                  arenaFirst, arenaUnits;      /* its 16 KB units */
 
-	bool init() APPLE_KEXT_OVERRIDE { scanoutPhys = 0; scanoutSlot = -1; values = NULL; purgeable = 0; wrapDelta = 0; wrapped = false; drawn = 0; gpuPool = false; poolSize = 0; return OSObject::init(); }
+	bool init() APPLE_KEXT_OVERRIDE { scanoutPhys = 0; scanoutSlot = -1; values = NULL; purgeable = 0; wrapDelta = 0; wrapped = false; drawn = 0; gpuPool = false; poolSize = 0; arenaChunk = -1; arenaFirst = arenaUnits = 0; return OSObject::init(); }
 	void free() APPLE_KEXT_OVERRIDE;
 
 	/* Kernel address of the pixels (mapped on first use), or 0. */
diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
index b360186..06693ab 100644
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -1071,6 +1071,8 @@ hw_init_regs(void)
 	gpu_wr(0x93, 1);                                /* RBBM_AHB_CNTL0 */
 	gpu_wr(0x2f, (1u << 30) | 0xffff);              /* RBBM_INTERFACE_HANG_INT_CNTL */
 	gpu_wr(0x464, 1);                               /* RBBM_PERFCTR_CNTL */
+	gpu_wr(0xbb0, 0);                               /* lavender: CP_PERFCTR_CP_SEL_0 = CP_ALWAYS_COUNT (core clocks) */
+	gpu_wr(0x46b, 6);                               /* RBBM_PERFCTR_RBBM_SEL_0 = 6: GPU busy (as a5xx devfreq) */
 	gpu_wr(0xe96, 2);                               /* UCHE_CACHE_WAYS */
 	gpu_wr64(0xe89, 0x0001fffffffff000ull);         /* UCHE_TRAP_BASE */
 	gpu_wr64(0xe87, 0x0001fffffffff000ull);         /* UCHE_WRITE_THRU_BASE */
@@ -1548,6 +1550,31 @@ topaz_osd_sampler(__unused void *param, __unused wait_result_t wr_)
 		if (++samples >= 1000) {
 			topaz_osd_gpu_busy = busy * 100 / samples;
 			samples = busy = 0;
+			/*
+			 * lavender: the core's real clock (CP_ALWAYS_COUNT against the 19.2 MHz always-on counter)
+			 * and how busy the core itself was (RBBM countable 6), every 5 s while it draws.
+			 */
+			static uint64_t last_cp, last_ao, last_busy;
+			static uint32_t secs;
+			if (ready && gpu != NULL) {
+				uint64_t cp = (uint64_t)gpu_rd(0x3a1) << 32 | gpu_rd(0x3a0);
+				uint64_t ao = (uint64_t)gpu_rd(0x4d3) << 32 | gpu_rd(0x4d2);
+				uint64_t bz = (uint64_t)gpu_rd(0x3b1) << 32 | gpu_rd(0x3b0);
+				if (++secs % 5 == 0 && last_ao != 0 && ao > last_ao && cp >= last_cp) {
+					uint64_t dcp = cp - last_cp, dao = ao - last_ao, dbz = bz - last_busy;
+					uint32_t mhz = (uint32_t)(dcp * 192 / dao / 10);
+					uint32_t core = dcp ? (uint32_t)(dbz * 100 / dcp) : 0;
+					if (topaz_osd_gpu_busy != 0 || core != 0) {
+						IOLog("LVGPU clock %u MHz core busy %u%% (pending %u%%)
+", mhz, core, topaz_osd_gpu_busy);
+					}
+				}
+				if (secs % 5 == 0 || last_ao == 0) {
+					last_cp = cp;
+					last_ao = ao;
+					last_busy = bz;
+				}
+			}
 		}
 	}
 }
