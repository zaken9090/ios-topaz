From ac6206d4595ff87bcc68bc7988718727f166c3ad Mon Sep 17 00:00:00 2001
From: zaken9090 <zaken9090@users.noreply.github.com>
Date: Sun, 22 Nov 2026 07:19:35 +0200
Subject: [PATCH] lavender: sweetfb_vhz - the vsync rate CoreAnimation sees
 (120: a finer frame grid)


diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index f398c83..da77eb7 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -131,6 +131,24 @@ enum {
 #define SWEET_FB_NOTIFY_TYPES           8
 #define SWEET_FB_NOTIFY_VSYNC           5
 #define SWEET_FB_VSYNC_US               16667
+/*
+ * lavender: boot-arg sweetfb_vhz=N - the display's rate as CoreAnimation sees it (modes and the
+ * vsync notifications), 60 by default. CoreAnimation starts frames on vsync ticks: a frame that
+ * takes 20 ms waits for the third 8.3 ms tick at 120 (40 fps) but the second 16.7 ms tick at 60
+ * (30 fps). The panel shows whatever was presented last either way.
+ */
+static uint32_t
+sweet_vhz(void)
+{
+	static uint32_t vhz = 0;
+	if (vhz == 0) {
+		uint32_t v = 60;
+		PE_parse_boot_argn("sweetfb_vhz", &v, sizeof(v));
+		vhz = (v >= 30 && v <= 240) ? v : 60;
+	}
+	return vhz;
+}
+#define SWEET_VSYNC_US                  (1000000u / sweet_vhz())
 #define SWEET_FB_DOT_PITCH              458     /* ppi, as the iPhone X panel */
 /*
  * The iOS userland only has status bar / layout data for real iPhone
@@ -511,12 +529,13 @@ AppleCLCD::start(IOService *provider)
 	}
 	uint32_t hz = 10;
 	PE_parse_boot_argn("sweetfb_hz", &hz, sizeof(hz));
-	fFlushTicks = (hz == 0 || hz >= 60) ? 1 : 60 / hz;
+	fFlushTicks = (hz == 0 || hz >= sweet_vhz()) ? 1 : sweet_vhz() / hz;
+	IOLog("SWEET FB: vsync %u Hz\n", sweet_vhz());
 	uint32_t lock = 0;
 	fVLock = PE_parse_boot_argn("sweetfb_lock", &lock, sizeof(lock)) && lock != 0 && fIntf1 != NULL && fVTotal > 100;
 	fPanelUS = 8333;
 	IOLog("SWEET FB: vsync %s the panel (%u lines a frame)\n", fVLock ? "follows" : "does not follow", fVTotal);
-	fVsync->setTimeoutUS(SWEET_FB_VSYNC_US);
+	fVsync->setTimeoutUS(SWEET_VSYNC_US);
 	uint32_t sync = 0;
 	if (!(PE_parse_boot_argn("sweetfb_sync", &sync, sizeof(sync)) && sync != 0) && (fQLock = IOLockAlloc()) != NULL) {
 		thread_t thread;
@@ -589,7 +608,7 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 				bzero(fb->backBuffer(), (size_t)fb->fRowBytes * fb->fHeight);
 				fb->flipBack();
 			}
-			sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+			sender->setTimeoutUS(SWEET_VSYNC_US);
 			return;
 		}
 		if (fb->fFadeOrig != NULL) {
@@ -607,7 +626,7 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 			if (step <= SWEET_FB_FADE_STEPS) {
 				fb->fadeStep(src, srcStride, step);
 			}
-			sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+			sender->setTimeoutUS(SWEET_VSYNC_US);
 			return;
 		}
 		if (fb->fVig0 != NULL && fb->fScanPhys != fb->fBootSrc) {
@@ -627,7 +646,7 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 				}
 			}
 		}
-		sender->setTimeoutUS(SWEET_FB_VSYNC_US);
+		sender->setTimeoutUS(SWEET_VSYNC_US);
 		return;
 	}
 	bool flush = fb->fDirty && (count % fb->fFlushTicks) == 0;
@@ -659,7 +678,7 @@ AppleCLCD::vsyncFired(OSObject *owner, IOTimerEventSource *sender)
 		memcpy(fb->fShowHold, taken, sizeof(taken));
 		IOLockUnlock(fb->fLock);
 	}
-	sender->setTimeoutUS(fb->fVLock ? fb->vsyncNext() : SWEET_FB_VSYNC_US);
+	sender->setTimeoutUS(fb->fVLock ? fb->vsyncNext() : SWEET_VSYNC_US);
 }
 
 /*
@@ -729,7 +748,7 @@ AppleCLCD::publishModes(void)
 	OSDictionary *color = OSDictionary::withCapacity(8);
 	OSArray *timings = OSArray::withCapacity(1);
 	OSArray *colors = OSArray::withCapacity(1);
-	const uint32_t rate = 60u << 16;        /* 16.16 */
+	const uint32_t rate = sweet_vhz() << 16; /* 16.16 */
 
 	if (timing != NULL && horizontal != NULL && vertical != NULL && color != NULL && timings != NULL && colors != NULL) {
 		sweet_set_number(color, "ID", SWEET_FB_COLOR_ID);
@@ -759,7 +778,7 @@ AppleCLCD::publishModes(void)
 		timings->setObject(timing);
 		setProperty("TimingElements", timings);
 		setProperty("ColorElements", colors);
-		IOLog("SWEET FB: modes published: %ux%u at 60 Hz\n", fLogicalW, fLogicalH);
+		IOLog("SWEET FB: modes published: %ux%u at %u Hz\n", fLogicalW, fLogicalH, sweet_vhz());
 	}
 	OSSafeReleaseNULL(timings);
 	OSSafeReleaseNULL(colors);
