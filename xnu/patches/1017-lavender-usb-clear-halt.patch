+/* Restart reason BOOTLOADER, warm PS_HOLD reset; true if every write went through. */
+static bool
+lv_pon_bootloader(void)
+{
+	uint8_t v = 0;
+	int r = lv_spmi_rw(false, 0, 0x88f, &v);
+	if (r == 0) {
+		v = (uint8_t)((v & 1) | (2u << 1));     /* PON_RESTART_REASON_BOOTLOADER (2) << 1, gen2 (1 = recovery) */
+		r = lv_spmi_rw(true, 0, 0x88f, &v);
+	}
+	if (r == 0 && lv_spmi_rw(false, 0, 0x85b, &v) == 0) {
+		v &= (uint8_t)~0x80;                    /* reset disabled while the type changes */
+		r = lv_spmi_rw(true, 0, 0x85b, &v);
+		delay(500);
+		if (r == 0 && lv_spmi_rw(false, 0, 0x85a, &v) == 0) {
+			v = (uint8_t)((v & ~0x0f) | 0x01);  /* PON_POWER_OFF_WARM_RESET */
+			r = lv_spmi_rw(true, 0, 0x85a, &v);
+		}
+		if (r == 0 && lv_spmi_rw(false, 0, 0x85b, &v) == 0) {
+			v |= 0x80;
+			r = lv_spmi_rw(true, 0, 0x85b, &v);
+		}
+		delay(500);
+	}
+	lv_pon_dump(r == 0 ? "set for fastboot" : "write FAILED");
+	return r == 0;
+}
