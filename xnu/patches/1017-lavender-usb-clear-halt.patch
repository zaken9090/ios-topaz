+extern "C" bool sweet_fb_shot_source(const uint8_t **va, uint32_t *stride, uint32_t *w, uint32_t *h);
+extern "C" bool
+sweet_fb_shot_source(const uint8_t **va, uint32_t *stride, uint32_t *w, uint32_t *h)
+{
+	AppleCLCD *fb = gSweetShot;
+	const uint8_t *p = NULL;
+
+	if (fb == NULL || fb->fScanPhys == 0) {
+		return false;
+	}
+	p = (const uint8_t *)topaz_gpu_pool_va(fb->fScanPhys);
+	for (int i = 0; p == NULL && i < 2; i++) {
+		if (fb->fFlip[i] != NULL && fb->fScanPhys == fb->fFlipPhys[i]) {
+			p = (const uint8_t *)fb->fFlip[i]->getBytesNoCopy();
+		}
+	}
+	if (p == NULL && fb->fScanPhys == fb->fBootSrc && fb->fPixels != 0) {
+		p = (const uint8_t *)fb->fPixels;
+	}
+	if (p == NULL) {
+		return false;
+	}
+	*va = p;
+	*stride = fb->fScanStride;
+	*w = fb->fWidth;
+	*h = fb->fHeight;
+	return true;
+}
