+/*
+ * lavender black box: the USB link died a minute or two into every boot with nothing in the
+ * log (the log goes out over this very link). When a TX transfer has waited 10 s, or a bus
+ * reset got no SETUP in 2 s, the controller state goes into the log, and the controller is
+ * reset and set up again so the PC re-enumerates it and reads that log.
+ */
+static void
+ud_watchdog(void)
+{
+	uint64_t now = mach_absolute_time(), s10, s2;
+	bool tx_stuck, reset_dead;
+
+	nanoseconds_to_absolutetime(10 * NSEC_PER_SEC, &s10);
+	nanoseconds_to_absolutetime(2 * NSEC_PER_SEC, &s2);
+	tx_stuck = ud_winusb() && ud.configured && ud.tx_busy && now - ud.tx_since > s10;
+	reset_dead = ud.reset_at != 0 && now - ud.reset_at > s2;
+	if (!tx_stuck && !reset_dead) {
+		return;
+	}
+	ud_sync(UD_TRB_OUT, 0x60);
+	volatile uint32_t *tt = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
+	volatile uint32_t *t0 = (volatile uint32_t *)(ud.dma + UD_TRB_OUT);
+	printf("SWEET USB: BLACKBOX %s: restart %u, ep0 state %u, tx_busy %d rx_active %d, tx %llu rx %llu, "
+	    "events %u evt_pos 0x%x GEVNTCOUNT %u\n", tx_stuck ? "TX stuck 10 s" : "no SETUP 2 s after reset",
+	    ud.restarts, ud.state, ud.tx_busy, ud.rx_active, ud.tx_frames, ud.rx_frames, ud.events, ud.evt_pos,
+	    dwc_rd(GEVNTCOUNT) & 0xffff);
+	printf("SWEET USB: BLACKBOX DSTS 0x%08x DCTL 0x%08x DCFG 0x%08x GSTS 0x%08x GCTL 0x%08x GUSB2PHYCFG 0x%08x "
+	    "DALEPENA 0x%08x DEPCMD tx 0x%08x rx 0x%08x ep0 0x%08x\n", dwc_rd(DSTS), dwc_rd(DCTL), dwc_rd(DCFG),
+	    dwc_rd(0xc118), dwc_rd(GCTL), dwc_rd(0xc200), dwc_rd(DALEPENA), dwc_rd(DEPCMD(EP_TX)),
+	    dwc_rd(DEPCMD(EP_RX)), dwc_rd(DEPCMD(0)));
+	printf("SWEET USB: BLACKBOX TRB tx %08x %08x %08x %08x ep0out %08x %08x %08x %08x\n",
+	    tt[0], tt[1], tt[2], tt[3], t0[0], t0[1], t0[2], t0[3]);
+	ud.restarts++;
+	ud_unconfigure();
+	lck_mtx_lock(ud.lock);
+	ud.tx_busy = false;
+	ud.reset_at = 0;
+	lck_mtx_unlock(ud.lock);
+	dwc_wr(DCTL, dwc_rd(DCTL) & ~DCTL_RUN_STOP);
+	for (int i = 0; i < 500 && !(dwc_rd(DSTS) & DSTS_DEVCTRLHLT); i++) {
+		delay(1000);
+	}
+	printf("SWEET USB: BLACKBOX controller restart %s\n", ud_hw_init() ? "done" : "FAILED");
+}
