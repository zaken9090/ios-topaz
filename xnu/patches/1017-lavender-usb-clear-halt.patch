+extern "C" bool sweet_fb_shot_source(const uint8_t **va, uint32_t *stride, uint32_t *w, uint32_t *h);
+extern "C" bool
+sweet_fb_shot_source(const uint8_t **va, uint32_t *stride, uint32_t *w, uint32_t *h)
+{
+	AppleCLCD *fb = gSweetShot;
+	const uint8_t *p = NULL;
