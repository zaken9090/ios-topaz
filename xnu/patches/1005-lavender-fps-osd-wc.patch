+/* lavender: the kernel's own (write-combined) view of GPU pool memory, or NULL (the fps OSD) */
+extern "C" void *topaz_gpu_pool_va(uint64_t pa);
+void *
+topaz_gpu_pool_va(uint64_t pa)
+{
+	if (pa < GPU_POOL_BASE || pa >= GPU_POOL_BASE + GPU_POOL_SIZE) {
+		return NULL;
+	}
+	unsigned c = (unsigned)((pa - GPU_POOL_BASE) / GPU_POOL_CHUNK);
+	return gpu_chunk_va[c] != NULL ? gpu_chunk_va[c] + (pa - GPU_POOL_BASE - c * GPU_POOL_CHUNK) : NULL;
+}
