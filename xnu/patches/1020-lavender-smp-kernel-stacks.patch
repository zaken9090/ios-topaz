From e68569afd51ff5c4e07587670d0b9599a06846ba Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Sat, 21 Nov 2026 02:26:25 +0200
Subject: [PATCH] lavender: lv:smp - user and kernel stacks of SpringBoard's
 and backboardd's threads now (a waiting thread: its kernel frame chain and
 wait event)

---
 bsd/dev/sweet_sample.c | 17 +++++++++++++++++
 bsd/dev/sweet_usb.c    |  5 +++++
 osfmk/kern/exception.c | 23 +++++++++++++++++++++++
 3 files changed, 45 insertions(+)

diff --git a/bsd/dev/sweet_sample.c b/bsd/dev/sweet_sample.c
index b40eccd..7949aca 100644
--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -78,6 +78,23 @@ sweet_sample_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 }
 
+/* lavender: one sample now (USB command lv:smp) */
+void sweet_sample_now(void);
+void
+sweet_sample_now(void)
+{
+	if (sweet_sample_names[0] == 0 &&
+	    !PE_parse_boot_argn("sweetsample", sweet_sample_names, sizeof(sweet_sample_names))) {
+		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
+	}
+	if (sweet_sample_names[0] == '-') {
+		strlcpy(sweet_sample_names, "SpringBoard,backboardd", sizeof(sweet_sample_names));
+	}
+	printf("SMP --- sample now\n");
+	proc_iterate(PROC_ALLPROCLIST, sweet_sample_proc, NULL, NULL, NULL);
+	printf("SMP --- done\n");
+}
+
 void
 sweet_sample_start(void)
 {
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index 614612b..71ca494 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -1468,6 +1468,11 @@ ud_w_command(const char *buf, uint32_t len)
 	    ud_w_put_command(buf, len)) {
 		return true;
 	}
+	if (len >= 6 && memcmp(buf, "lv:smp", 6) == 0) {
+		extern void sweet_sample_now(void);     /* bsd/dev/sweet_sample.c: user and kernel stacks */
+		sweet_sample_now();
+		return true;
+	}
 	if (len >= 6 && memcmp(buf, "lv:pon", 6) == 0) {            /* lavender: PON registers, no change */
 		lv_pon_dump("now");
 		return true;
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index a20a764..9c5e8b7 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1036,6 +1036,29 @@ sweet_sample_task(const char *name, int pid, task_t task)
 			fp = frame[0];
 		}
 		printf("%s\n", line);
+		/*
+		 * lavender: a thread that is waiting: where in the kernel (its saved kernel fp/lr and the
+		 * frame chain on its kernel stack, unslid; the event it waits on, raw). A daemon stuck in
+		 * a lock of a driver shows here (the user backtrace above only shows the system call).
+		 */
+		if (thread != current_thread() && (thread->state & TH_WAIT) && thread->kernel_stack != 0 &&
+		    thread->machine.kstackptr != 0) {
+			struct arm_kernel_saved_state *ks = &((thread_kernel_state_t)thread->machine.kstackptr)->machine.ss;
+			uint64_t lo = thread->kernel_stack;
+			uint64_t hi = thread->machine.kstackptr + sizeof(struct thread_kernel_state);
+			uint64_t kfp = ks->fp;
+			n = snprintf(line, sizeof(line), "SMK %s t%d ev 0x%llx lr 0x%llx bt", name, tn - 1,
+			    (unsigned long long)thread->wait_event, (unsigned long long)VM_KERNEL_UNSLIDE(ks->lr));
+			for (int i = 0; i < 16 && kfp >= lo && kfp + 16 <= hi && (kfp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+				const uint64_t *frame = (const uint64_t *)kfp;
+				n += snprintf(line + n, sizeof(line) - n, " 0x%llx", (unsigned long long)VM_KERNEL_UNSLIDE(frame[1]));
+				if (frame[0] <= kfp) {
+					break;
+				}
+				kfp = frame[0];
+			}
+			printf("%s\n", line);
+		}
 	}
 	task_unlock(task);
 }
-- 
