@@ -1542,6 +1542,28 @@ topaz_adreno_thread(__unused void *param, __unused wait_result_t wr_)
 	{
 		uint32_t diag = 0;
 		if (PE_parse_boot_argn("gpudiag", &diag, sizeof(diag)) && diag == 1) {
+			if (!gpu_identity && smmu != NULL) {
+				/*
+				 * lavender SMMU translation debug: what the table says and what the SMMU's own
+				 * address translation (CB_ATS1PR 0x800 -> CB_PAR 0x50, CB_ATSR 0x8f0) makes of
+				 * the microcode, the ring and the memstore.
+				 */
+				const uint64_t vas[] = { sqe.iova, pfp.iova, pfp.iova + 0x3000, ring.iova, mem.iova };
+				IOLog("TopazGPU: SMMU FAR %08x%08x FSYNR0 %08x FSR %08x TTBR0 %08x%08x l1[3] %llx\n",
+				    rd(smmu, SMMU_CB0 + 0x64), rd(smmu, SMMU_CB0 + 0x60), rd(smmu, SMMU_CB0 + 0x68),
+				    rd(smmu, SMMU_CB0 + 0x58), rd(smmu, SMMU_CB0 + 0x24), rd(smmu, SMMU_CB0 + 0x20),
+				    l1.va ? l1.va[3] : 0);
+				for (unsigned i = 0; i < sizeof(vas) / sizeof(vas[0]); i++) {
+					uint64_t va = vas[i], *l3t = l3_for(va, false);
+					wr(smmu, SMMU_CB0 + 0x058, 0xFFFFFFFF);
+					wr(smmu, SMMU_CB0 + 0x800, (uint32_t)(va & ~0xfffull));
+					wr(smmu, SMMU_CB0 + 0x804, (uint32_t)(va >> 32));
+					(void)poll(smmu, SMMU_CB0 + 0x8f0, 1, 0, 1000);
+					IOLog("TopazGPU: ATS va %llx -> PAR %08x%08x ATSR %x | pte %llx\n", va,
+					    rd(smmu, SMMU_CB0 + 0x54), rd(smmu, SMMU_CB0 + 0x50), rd(smmu, SMMU_CB0 + 0x8f0),
+					    l3t ? l3t[(va >> 12) & 511] : 0);
+				}
+			}
 			panic("TopazGPU diag (lavender a512): start %s | GX %08x CX %08x | RBBM_STATUS %08x SECVID_TRUST %08x "
 			    "CP_HW_FAULT %08x INT %08x | rptr %u wptr %u | SMMU cb0 SCTLR %08x FSR %08x | core %u MHz | rpm %d cx %#x ddr %u",
 			    ok ? "OK" : "FAILED", gpucc ? rd(gpucc, 0x1094) : 0, gpucc ? rd(gpucc, 0x1004) : 0,
