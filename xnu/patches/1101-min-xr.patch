+/*
+ * lavender-minimal (sweetfb_xr): VIG0 fetches 828x1792 at stride 3328 from the boot framebuffer
+ * and QSEED3 (VIG0 + 0xa00, bilinear, no LUT; mdss_mdp_qseed3_setup in Xiaomi's lavender
+ * kernel) makes 1080x2340 of it; CTL0 FLUSH latches VIG0 + CTL at the next vsync.
+ */
+void
+AppleCLCD::xrEnable(void)
+{
+	const uint32_t sw = fLogicalW, sh = fLogicalH;
+	volatile uint32_t *sc = fXrVig + 0xa00 / 4;
+
+	bzero((void *)fPixels, (size_t)sw * 4 * sh);
+	fXrVig[0x00 / 4] = (sh << 16) | sw;             /* SSPP_SRC_SIZE */
+	fXrVig[0x04 / 4] = (sh << 16) | sw;             /* SSPP_SRC_IMG_SIZE */
+	fXrVig[0x08 / 4] = 0;                           /* SSPP_SRC_XY */
+	fXrVig[0x24 / 4] = sw * 4;                      /* SSPP_SRC_YSTRIDE0 */
+	for (uint32_t off = 0; off <= 32; off += 16) {  /* SW pixel extension, planes 0, 1/2, 3 */
+		fXrVig[(0x100 + off) / 4] = 0;
+		fXrVig[(0x104 + off) / 4] = 0;
+		fXrVig[(0x108 + off) / 4] = (sh << 16) | sw;
+	}
+	uint32_t stepx = (uint32_t)(((uint64_t)sw << 21) / fWidth), stepy = (uint32_t)(((uint64_t)sh << 21) / fHeight);
+	sc[0x0c / 4] = 0;                               /* PHASE_INIT */
+	sc[0x10 / 4] = stepx;                           /* PHASE_STEP_Y_H */
+	sc[0x14 / 4] = stepy;                           /* PHASE_STEP_Y_V */
+	sc[0x18 / 4] = stepx;                           /* PHASE_STEP_UV_H */
+	sc[0x1c / 4] = stepy;                           /* PHASE_STEP_UV_V */
+	sc[0x20 / 4] = 0x03040304;                      /* PRELOAD: 4 across, 3 down */
+	sc[0x40 / 4] = (sh << 16) | sw;                 /* SRC_SIZE_Y_RGB_A */
+	sc[0x44 / 4] = (sh << 16) | sw;                 /* SRC_SIZE_UV */
+	sc[0x48 / 4] = (fHeight << 16) | fWidth;        /* DST_SIZE */
+	sc[0x04 / 4] = 1u | (1u << 14) | (3u << 16) | (3u << 24) | (1u << 31);  /* OP_MODE: on, 8-bit, bilinear */
+	__asm__ volatile("dsb sy" ::: "memory");
+	fXrCtl[0x18 / 4] = 0x20001;                     /* CTL0 FLUSH: VIG0 + CTL */
+	__asm__ volatile("dsb sy" ::: "memory");
+	fXrOn = true;
+	IOLog("SWEET FB: XR: VIG0 QSEED3 (version %#x) scales %ux%u to %ux%u\n", sc[0], sw, sh, fWidth, fHeight);
+}
