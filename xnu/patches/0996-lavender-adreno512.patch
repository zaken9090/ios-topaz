+/*
+ * lavender: GPU firmware handed over by the boot shim (vendor blobs stay out of
+ * the public tree): at LV_FW_PA a header "LVGPUFW1", count, then entries
+ * { char name[24]; uint32_t offset, size; } with offsets from LV_FW_PA. The
+ * root filesystem (FW_DIR) is tried first.
+ */
+#define LV_FW_PA        0xBF000000ull
+#define LV_FW_SIZE      0x40000
+
+static int
+fw_get(const char *name, void **data, size_t *size, bool *from_fs)
+{
+	char path[96];
+	snprintf(path, sizeof(path), FW_DIR "%s", name);
+	if (topaz_fw_read(path, data, size) == 0) {
+		*from_fs = true;
+		return 0;
+	}
+	*from_fs = false;
+	volatile uint8_t *b = (volatile uint8_t *)ml_io_map(LV_FW_PA, LV_FW_SIZE);
+	if (b == NULL || memcmp((const void *)b, "LVGPUFW1", 8) != 0) {
+		IOLog("TopazGPU: %s: not in " FW_DIR " and no shim firmware block\n", name);
+		return -1;
+	}
+	uint32_t n = *(volatile uint32_t *)(b + 8);
+	for (uint32_t i = 0; i < n && i < 16; i++) {
+		volatile uint8_t *e = b + 16 + 32 * i;
+		if (strncmp((const char *)e, name, 24) == 0) {
+			uint32_t off = *(volatile uint32_t *)(e + 24), len = *(volatile uint32_t *)(e + 28);
+			if (off + len > LV_FW_SIZE || len == 0) {
+				return -1;
+			}
+			void *copy = IOMalloc(len);
+			if (copy == NULL) {
+				return -1;
+			}
+			for (uint32_t k = 0; k < len; k++) {
+				((uint8_t *)copy)[k] = b[off + k];
+			}
+			*data = copy;
+			*size = len;
+			IOLog("TopazGPU: %s: %u bytes from the shim firmware block\n", name, len);
+			return 0;
+		}
+	}
+	IOLog("TopazGPU: %s: not in the shim firmware block\n", name);
+	return -1;
+}
+
+static void
+fw_put(void *data, size_t size, bool from_fs)
+{
+	if (data == NULL) {
+		return;
+	}
+	if (from_fs) {
+		topaz_fw_free(data, size);
+	} else {
+		IOFree(data, size);
+	}
+}
