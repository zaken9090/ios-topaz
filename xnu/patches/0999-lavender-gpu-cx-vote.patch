diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
index 5cb88a2..98fa999 100644
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -110,6 +110,9 @@ uint32_t gpu_log;
 static volatile uint8_t *gcc, *gpucc, *gpu, *smmu, *gfxldo;
 static bool ready, failed, smmu_on;
 static uint32_t wptr, seqno, core_mhz = 300;
+static uint32_t cx_level;                       /* lavender: the CX level voted for gpu_mhz=600 (0: none) */
+extern "C" bool topaz_rpm_write(uint32_t set, uint32_t type, uint32_t id, uint32_t key, uint32_t value);
+extern "C" int topaz_rpm_status;
 static uint32_t submits, submit_ibs, submit_full;     /* gpudiag=2 statistics */
 static IOLock *hw_lock;
 
@@ -546,6 +549,29 @@ power_up(void)
 	rmw(gpucc, 0x1090, 0, 1);
 	IODelay(1);
 	rmw(gpucc, 0x1090, 1, 0);
+	/*
+	 * lavender: the GPU core sits on CX (vdd_gfx is a stub in the DT; cpr4 gfx "system-voltage"
+	 * per corner 160/266 MHz LOW_SVS 0x40, 370 SVS 0x80, 465 SVS_L1 0xc0, 588 NOM 0x100, 647 NOM_L1
+	 * 0x140, 750 TURBO 0x180). 600 MHz: vote CX NOM_L1 (gpu_cx=LEVEL overrides) through the RPM
+	 * (rwcx 0, key vlvl) and set the GFX memory accelerator to its high corner (0x1fcf004 bit 0);
+	 * without the vote the GPU stays at 300.
+	 */
+	if (core_mhz >= 600) {
+		uint32_t level = 0x140;
+		PE_parse_boot_argn("gpu_cx", &level, sizeof(level));
+		if (topaz_rpm_write(0, 0x78637772u /* rwcx */, 0, 0x6c766c76u /* vlvl */, level)) {
+			volatile uint32_t *acc = (volatile uint32_t *)ml_io_map(0x1fcf000, 0x1000);
+			if (acc != NULL) {
+				acc[1] |= 1;
+			}
+			cx_level = level;
+			IODelay(200);
+			IOLog("TopazGPU: CX level %#x voted, mem-acc high\n", level);
+		} else {
+			IOLog("TopazGPU: no CX vote (RPM status %d): 300 MHz\n", topaz_rpm_status);
+			core_mhz = 300;
+		}
+	}
 	/* gfx3d from GPLL0 (600 MHz): /2 = 300 (default) or /1 = 600; gpu_mhz=19: XO */
 	if (core_mhz < 300) {
 		core_mhz = 19;
@@ -1492,11 +1518,11 @@ topaz_adreno_thread(__unused void *param, __unused wait_result_t wr_)
 		uint32_t diag = 0;
 		if (PE_parse_boot_argn("gpudiag", &diag, sizeof(diag)) && diag == 1) {
 			panic("TopazGPU diag (lavender a512): start %s | GX %08x CX %08x | RBBM_STATUS %08x SECVID_TRUST %08x "
-			    "CP_HW_FAULT %08x INT %08x | rptr %u wptr %u | SMMU cb0 SCTLR %08x FSR %08x | core %u MHz",
+			    "CP_HW_FAULT %08x INT %08x | rptr %u wptr %u | SMMU cb0 SCTLR %08x FSR %08x | core %u MHz | rpm %d cx %#x",
 			    ok ? "OK" : "FAILED", gpucc ? rd(gpucc, 0x1094) : 0, gpucc ? rd(gpucc, 0x1004) : 0,
 			    gpu ? gpu_rd(0x4f5) : 0, gpu ? gpu_rd(0xf400) : 0, gpu ? gpu_rd(0xb1a) : 0, gpu ? gpu_rd(0x4e1) : 0,
 			    gpu ? gpu_rd(0x806) : 0, wptr % RB_DWORDS, smmu ? rd(smmu, SMMU_CB0) : 0,
-			    smmu ? rd(smmu, SMMU_CB0 + 0x58) : 0, core_mhz);
+			    smmu ? rd(smmu, SMMU_CB0 + 0x58) : 0, core_mhz, topaz_rpm_status, cx_level);
 		}
 	}
 	if (!ok) {
diff --git a/iokit/Kernel/arm/TopazRpm.cpp b/iokit/Kernel/arm/TopazRpm.cpp
index 419835e..c4b64ad 100644
--- a/iokit/Kernel/arm/TopazRpm.cpp
+++ b/iokit/Kernel/arm/TopazRpm.cpp
@@ -18,9 +18,22 @@
 #define LOG(fmt, ...)       IOLog("TopazRpm: " fmt "\n", ##__VA_ARGS__)
 
 extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
-extern "C" void topaz_apcs_kick(unsigned bit);
+extern "C" int topaz_rpm_status;
+int topaz_rpm_status;          /* lavender: 0 not tried, 1 up, -1 no TOC, -2 no FIFOs, -3 FIFOs used, -4 no VERSION, -5 not open, -6 request refused */
+static volatile uint32_t *rpm_ipc;
+static void
+rpm_kick(void)
+{
+	if (rpm_ipc == NULL) {
+		rpm_ipc = (volatile uint32_t *)(ml_io_map(0x17911000ull, 0x1000) + 8)   /* lavender APCS IPC */;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*rpm_ipc = 1u << 0;                     /* RPM_IPC_BIT (qcom,irq-mask 1) */
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
 
-#define MSG_RAM_PA          0x045F0000ull
+#define MSG_RAM_PA          0x00778000ull     /* lavender (SDM660): qcom,glink-rpm-native-xprt msgram */
+#define RPM_IPC_PA          0x17911000ull     /* lavender: APCS IPC, irq-reg-base 0x17911008 */
 #define MSG_RAM_SIZE        0x7000u
 #define TOC_SIZE            256u
 #define TOC_MAGIC           0x67727430u     /* "grt0" */
@@ -66,7 +79,7 @@ tx_send(const void *msg, uint32_t len)
 		}
 	}
 	wr(tx_off + 4, head);
-	topaz_apcs_kick(RPM_IPC_BIT);
+	rpm_kick();
 	return true;
 }
 
@@ -231,6 +244,7 @@ link(void)
 	ram = (volatile uint8_t *)ml_io_map(MSG_RAM_PA, MSG_RAM_SIZE);
 	if (ram == NULL || rd(toc) != TOC_MAGIC || rd(toc + 4) > (TOC_SIZE - 8) / 12) {
 		LOG("message RAM: no TOC");
+		topaz_rpm_status = -1;
 		return false;
 	}
 	for (uint32_t i = 0; i < rd(toc + 4); i++) {
@@ -248,15 +262,18 @@ link(void)
 	}
 	if (tx_size == 0 || rx_size == 0) {
 		LOG("no ap2r/r2ap FIFO in the TOC");
+		topaz_rpm_status = -2;
 		return false;
 	}
 	if (rd(tx_off) != 0 || rd(tx_off + 4) != 0 || rd(rx_off) != 0 || rd(rx_off + 4) != 0) {
 		LOG("FIFOs used since boot: no second handshake (it crashed the RPM on Windows)");
+		topaz_rpm_status = -3;
 		return false;
 	}
 	send_cmd(CMD_VERSION, 1, 0);
 	if (!wait_for(is_version, 1000)) {
 		LOG("no VERSION answer");
+		topaz_rpm_status = -4;
 		return false;
 	}
 	struct { uint32_t hdr[2]; char name[16]; } open;
@@ -267,9 +284,11 @@ link(void)
 	tx_send(&open, sizeof(open));
 	if (!wait_for(is_open, 1000)) {
 		LOG("rpm_requests not open (ack %u remote %u)", open_ack, remote_open);
+		topaz_rpm_status = -5;
 		return false;
 	}
 	LOG("rpm_requests open");
+	topaz_rpm_status = 1;
 	return true;
 }
 
@@ -321,6 +340,9 @@ topaz_rpm_write(uint32_t set, uint32_t type, uint32_t id, uint32_t key, uint32_t
 	m.value = value;
 	static_assert(sizeof(m) == 56, "rpm message");
 	ok = tx_send(&m, sizeof(m)) && wait_for(is_answered, 1000) && !last_err;
+	if (!ok) {
+		topaz_rpm_status = -6;
+	}
 	IOLockUnlock(rpm_lock);
 	return ok;
 }
