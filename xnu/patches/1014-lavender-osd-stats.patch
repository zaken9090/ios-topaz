+/* lavender OSD: % of 1 ms samples in the last second with a submission not done yet */
+extern "C" uint32_t topaz_osd_gpu_busy;
+uint32_t topaz_osd_gpu_busy;
+
+static void
+topaz_osd_sampler(__unused void *param, __unused wait_result_t wr_)
+{
+	uint32_t samples = 0, busy = 0;
+
+	for (;;) {
+		IOSleep(1);
+		if (ready && mem.va != NULL) {
+			busy += *(volatile uint32_t *)mem.va != seqno;
+		}
+		if (++samples >= 1000) {
+			topaz_osd_gpu_busy = busy * 100 / samples;
+			samples = busy = 0;
+		}
+	}
+}
