lavender-0995: SDM660 MDP5 VIG0/CTL0 for the double-buffered flip path

Shim probe: VIG0 (0xc905000) scans the ABL splash on CTL0 (0xc902000);
pointing SRC0_ADDR elsewhere + FLUSH 0x20001 switches the panel. Frames are
then composed in cached flip buffers instead of the uncached splash.
Boot-arg sweetfb_mdp=0 restores the copy-into-splash path.

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 3610f62..0879059 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -353,12 +353,25 @@ AppleCLCD::start(IOService *provider)
 		return false;
 	}
 	/*
-	 * lavender (SDM660): the SM6225 MDP/DSI blocks below do not exist here
-	 * (MDSS is at 0xc900000). No register access: frames are CPU-copied into
-	 * the ABL splash buffer (fVig0 == NULL path), the panel keeps scanning it.
+	 * lavender (SDM660 MDP5 at 0xc900000, layout from the lavender DTB and a
+	 * shim probe): ABL scans the splash with source pipe VIG0 (mdp+0x5000)
+	 * on CTL0 (mdp+0x2000); SRC0_ADDR +0x14, YSTRIDE +0x24 and CTL FLUSH +0x18
+	 * = 0x20001 (VIG0 + CTL) work exactly as on topaz's DPU, so the double
+	 * buffered flip path applies. The MDP takes 32-bit addresses: the flip
+	 * buffers need kernel RAM below 4 GB (silver ADT: RAM from 0xc0000000).
+	 * sweetfb_mdp=0: no MDP access, frames copied into the splash (old path).
 	 */
-	fVig0 = NULL;
-	fCtl0 = NULL;
+	{
+		uint32_t mdp = 1;
+		PE_parse_boot_argn("sweetfb_mdp", &mdp, sizeof(mdp));
+		fVig0 = mdp ? (volatile uint32_t *)ml_io_map(0x0c905000, 0x1000) : NULL;
+		fCtl0 = mdp ? (volatile uint32_t *)ml_io_map(0x0c902000, 0x1000) : NULL;
+		if (fVig0 != NULL && fVig0[0x14 / 4] != 0x9d400000u) {
+			IOLog("SWEET FB: VIG0 scans %#x, not the splash: MDP left alone\n", fVig0[0x14 / 4]);
+			fVig0 = NULL;
+			fCtl0 = NULL;
+		}
+	}
 	topaz_adreno_init();
 	setProperty("RedwoodWaitsForGPU", true);         /* present() waits for the GPU (eagl.c reads it) */
 	fDsi = NULL;    /* lavender: no SM6225 DSI0 at 0x05e94000 */
