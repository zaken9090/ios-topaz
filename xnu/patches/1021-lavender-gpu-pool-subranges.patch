From e76eba4dcf7273b7b4ce85d012cc83d4752f0b6d Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Sat, 21 Nov 2026 04:27:20 +0200
Subject: [PATCH] lavender: GPU pool descriptors are parts of their chunk's
 (kept, kernel-mapped): the last unmap of a descriptor of its own destroyed
 its device pager object and backboardd waited in vm_object_destroy for good
 (the lock-screen freeze)

---
 iokit/Kernel/arm/TopazAdreno.cpp | 31 ++++++++++++++++++++++++++++---
 1 file changed, 28 insertions(+), 3 deletions(-)

diff --git a/iokit/Kernel/arm/TopazAdreno.cpp b/iokit/Kernel/arm/TopazAdreno.cpp
index db36d96..4af7acf 100644
--- a/iokit/Kernel/arm/TopazAdreno.cpp
+++ b/iokit/Kernel/arm/TopazAdreno.cpp
@@ -19,6 +19,7 @@
  */
 #include <IOKit/IOLib.h>
 #include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOSubMemoryDescriptor.h>
 #include <IOKit/IOLocks.h>
 #include <pexpert/pexpert.h>
 #include <kern/thread.h>
@@ -177,6 +178,7 @@ kbuf_pa(struct kbuf *b, uint64_t off)
 #define GPU_POOL_CHUNK      0x4000000ull        /* 64 MB: mapped on first use (1 GB at once is more IO space than there is) */
 #define GPU_POOL_CHUNKS     (GPU_POOL_SIZE / GPU_POOL_CHUNK)
 static uint8_t *gpu_chunk_va[GPU_POOL_CHUNKS];
+static IOMemoryDescriptor *gpu_chunk_md[GPU_POOL_CHUNKS];   /* lavender: kept for good, mapped in the kernel */
 static bool gpu_pool_ready;
 static struct { uint64_t start, size; } pool_free[2048];
 static unsigned pool_free_count;
@@ -233,12 +235,34 @@ range_alloc(void *table, unsigned *count, uint64_t size)
  * unaligned accesses there were SIGBUS). The kIOMapWriteCombineCache option of
  * the mapping alone does not change it.
  */
+static IOMemoryDescriptor *
+gpu_pool_phys_md(uint64_t pa, uint64_t size)
+{
+	return IOMemoryDescriptor::withAddressRange(pa, size,
+	           kIODirectionInOut | (kIOWriteCombineCache << kIOMemoryBufferCacheShift), TASK_NULL);
+}
+
+/*
+ * lavender: a buffer's descriptor is a part of its chunk's, which lives for good with the kernel's
+ * mapping of the chunk. A descriptor of its own was a device pager of its own, and the last unmap
+ * of one (a surface or a Mesa buffer let go) destroyed its VM object: backboardd's render thread
+ * waited in vm_object_destroy for good (lck_rw_sleep, from IOGeneralMemoryDescriptor::
+ * memoryReferenceFree; lv:smp, 2026-11-21) and the screen froze a minute or two after boot.
+ * The chunk's pager stays mapped, so that never happens to it.
+ */
 extern "C" IOMemoryDescriptor *topaz_gpu_pool_md(uint64_t pa, uint64_t size);
 IOMemoryDescriptor *
 topaz_gpu_pool_md(uint64_t pa, uint64_t size)
 {
-	return IOMemoryDescriptor::withAddressRange(pa, size,
-	           kIODirectionInOut | (kIOWriteCombineCache << kIOMemoryBufferCacheShift), TASK_NULL);
+	if (pa >= GPU_POOL_BASE && pa + size <= GPU_POOL_BASE + GPU_POOL_SIZE) {
+		unsigned c = (unsigned)((pa - GPU_POOL_BASE) / GPU_POOL_CHUNK);
+		uint64_t off = pa - GPU_POOL_BASE - c * GPU_POOL_CHUNK;
+		if (gpu_chunk_md[c] != NULL && off + size <= GPU_POOL_CHUNK) {
+			return IOSubMemoryDescriptor::withSubRange(gpu_chunk_md[c], (IOByteCount)off, (IOByteCount)size,
+			           kIODirectionInOut);
+		}
+	}
+	return gpu_pool_phys_md(pa, size);
 }
 
 /* boot-arg gpu_midmem=1: the ADT gives the kernel RAM below 4 GiB (mkadt.py --midmem), GPU memory is the kernel's */
@@ -275,10 +299,11 @@ topaz_gpu_pool_alloc(uint64_t size, void **va)
 	unsigned c = (unsigned)((pa - GPU_POOL_BASE) / GPU_POOL_CHUNK);
 	if (gpu_chunk_va[c] == NULL) {
 		/* in the kernel map, not the small IO submap ml_io_map uses (64 MB there failed) */
-		IOMemoryDescriptor *md = topaz_gpu_pool_md(GPU_POOL_BASE + c * GPU_POOL_CHUNK, GPU_POOL_CHUNK);
+		IOMemoryDescriptor *md = gpu_pool_phys_md(GPU_POOL_BASE + c * GPU_POOL_CHUNK, GPU_POOL_CHUNK);
 		IOMemoryMap *map = md != NULL ? md->map(kIOMapWriteCombineCache) : NULL;
 		if (map != NULL) {
 			gpu_chunk_va[c] = (uint8_t *)map->getVirtualAddress();     /* (kept for good, with md) */
+			gpu_chunk_md[c] = md;
 		}
 		if (gpu_chunk_va[c] == NULL) {
 			OSSafeReleaseNULL(map);
-- 
