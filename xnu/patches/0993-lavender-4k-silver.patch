lavender-0993: TOPAZ_4K kernel on the silver cluster (Redmi Note 7)

The 4 KiB-page build (topaz 0140-0142) with the lavender splash framebuffer
0x9d400000 instead of topaz 0x5c000000, and no AMP: XNU runs on the four
Cortex-A53 (1.37 GHz), the gold cluster stays off (it runs at 1/4 clock).
Only takes effect with TOPAZ_4K=1.

diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 1c72435..7dc587c 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1853,7 +1853,7 @@ sweet_early_map_final(void)
 		}
 	}
 	for (unsigned int i = 0; i < 6; i++) {
-		l2[first + i] = (0x5c000000ULL + i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		l2[first + i] = (0x9d400000ULL + i * ARM_TT_L2_SIZE) /* lavender splash */ | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index a8901e7..ec4fa47 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -516,7 +516,7 @@ LEXT(start_first_cpu)
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
 #if defined(TOPAZ_4K)
-	MOV64	x0, (0x5c000000 + 2368 * 4320)	/* topaz splash framebuffer */
+	MOV64	x0, (0x9d400000 + 2308 * 4320)	/* lavender splash, bottom 32 rows (4K) */
 #else
 	MOV64	x0, (0x9d400000 + 2308 * 4320)	/* lavender splash, bottom 32 rows */
 #endif
@@ -689,7 +689,7 @@ Lkernelcache_base_found:
 	 * RAM is at 0x140000000), for the early screen console.
 	 */
 	add		x2, x2, PGBYTES
-	MOV64	x10, 0x5c000000
+	MOV64	x10, 0x9d400000	/* lavender splash (L1 index 2; kernel RAM at 0x100000000) */
 	create_l1_table_entry x10, x1, x2, x11, x12, x13
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index bf30c0f..68ca09f 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -12,7 +12,7 @@
 #include <kern/misc_protos.h>
 
 #if defined(TOPAZ_4K)
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x5c000000;  /* topaz splash */
+static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9d400000;  /* lavender splash (4K) */
 #else
 /* lavender (Redmi Note 7): ABL splash 0x9d400000, 1080x2340, stride 4320 */
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9d400000;
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index cfeb976..202d769 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -43,7 +43,8 @@
  * silver A53 = E cluster (ADT cluster-type). The Edge scheduler then keeps
  * threads on P and spills to E only when P is busy (no CLPC recommends).
  */
-#define __ARM_AMP__               1
+/* lavender: XNU boots on the silver A53 cluster only (gold runs at 1/4
+ * clock, see lavender/dump probes); one homogeneous cluster, no AMP. */
 #endif
 
 #define HAS_GIC_V3                1
