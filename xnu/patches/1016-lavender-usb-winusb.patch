+/*
+ * lavender: a WinUSB function instead of CDC-ECM (Windows has no in-box ECM driver). Vendor
+ * class interface 0 with bulk IN 0x81 (the console log, as it is written) and bulk OUT 0x01;
+ * a BOS platform capability with MS OS 2.0 descriptors (CompatibleID "WINUSB" and a
+ * DeviceInterfaceGUID) makes Windows 8.1+ bind WinUSB by itself, nothing to install. The PC
+ * reads it with tools/usblog.py. VID 0x1209 / PID 0x0002 (pid.codes test IDs).
+ */
+#define UD_MSOS_VENDOR  0x20
+static const uint8_t ud_w_dev_desc[18] = {
+	18, 1, 0x10, 0x02, 0xff, 0x00, 0x00, 64,
+	0x09, 0x12, 0x02, 0x00, 0x00, 0x01, 1, 2, 3, 1,
+};
+static const uint8_t ud_w_cfg_desc[32] = {
+	9, 2, 32, 0, 1, 1, 0, 0x80, 250,                /* config: 1 interface, 500 mA */
+	9, 4, 0, 0, 2, 0xff, 0x00, 0x00, 0,             /* interface 0: vendor, 2 endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
+};
+#define UD_MSOS_SET_LEN 162
+static const uint8_t ud_w_bos[33] = {
+	5, 0x0f, 33, 0, 1,                              /* BOS: 33 bytes, 1 capability */
+	28, 0x10, 0x05, 0x00,                           /* platform capability */
+	0xdf, 0x60, 0xdd, 0xd8, 0x89, 0x45, 0xc7, 0x4c, /* MS OS 2.0 UUID D8DD60DF-4589-4CC7-9CD2-659D9E648A9F */
+	0x9c, 0xd2, 0x65, 0x9d, 0x9e, 0x64, 0x8a, 0x9f,
+	0x00, 0x00, 0x03, 0x06,                         /* Windows 8.1 */
+	UD_MSOS_SET_LEN, 0, UD_MSOS_VENDOR, 0,
+};
+
+static uint32_t
+ud_w_msos_set(uint8_t *o)
+{
+	static const char guid[] = "{8F6B4C2E-5A1D-4E7B-9C3A-2D6E1F0A7B55}";
+	static const char name[] = "DeviceInterfaceGUIDs";
+	uint32_t n = 0;
+
+	/* set header */
+	o[n++] = 10; o[n++] = 0; o[n++] = 0; o[n++] = 0;
+	o[n++] = 0x00; o[n++] = 0x00; o[n++] = 0x03; o[n++] = 0x06;
+	o[n++] = UD_MSOS_SET_LEN; o[n++] = 0;
+	/* compatible ID "WINUSB" */
+	o[n++] = 20; o[n++] = 0; o[n++] = 3; o[n++] = 0;
+	memcpy(o + n, "WINUSB\0\0", 8); n += 8;
+	bzero(o + n, 8); n += 8;
+	/* registry property DeviceInterfaceGUIDs, REG_MULTI_SZ */
+	o[n++] = 132; o[n++] = 0; o[n++] = 4; o[n++] = 0;
+	o[n++] = 7; o[n++] = 0;
+	o[n++] = 42; o[n++] = 0;
+	for (unsigned i = 0; i < sizeof(name); i++) {   /* (with its terminating NUL: 21 UTF-16 units) */
+		o[n++] = (uint8_t)name[i]; o[n++] = 0;
+	}
+	o[n++] = 80; o[n++] = 0;
+	for (unsigned i = 0; i < sizeof(guid); i++) {   /* 39 units with the NUL ... */
+		o[n++] = (uint8_t)guid[i]; o[n++] = 0;
+	}
+	o[n++] = 0; o[n++] = 0;                         /* ... and the list's final NUL */
+	return n;
+}
+
+static bool
+ud_winusb(void)
+{
+	static int mode = -1;
+	if (mode < 0) {
+		uint32_t v = 1;
+		PE_parse_boot_argn("lv_winusb", &v, sizeof(v));
+		mode = v != 0;
+	}
+	return mode != 0;
+}
+
+/* Send len bytes from buf on the bulk IN endpoint (WinUSB mode); false if busy/not configured. */
+static bool
+ud_w_send(const char *buf, uint32_t len)
+{
+	bool sent = false;
+
+	lck_mtx_lock(ud.lock);
+	if (ud.configured && !ud.tx_busy && len > 0 && len < UD_FRAME_MAX) {
+		memcpy((void *)(ud.dma + UD_TX), buf, len);
+		ud.tx_busy = true;
+		ud.tx_frames++;
+		ud_start_trb(EP_TX, UD_TRB_TX, UD_TX, len, TRBCTL_NORMAL);
+		sent = true;
+	}
+	lck_mtx_unlock(ud.lock);
+	return sent;
+}
