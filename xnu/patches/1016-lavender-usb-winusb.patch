+/*
+ * lavender: commands from the PC on bulk OUT 0x01 (WinUSB mode, tools/usblog.py --cmd):
+ *   "lv:fastboot"  restart into the bootloader's fastboot: IMEM restart_reason (DT
+ *                  qcom,msm-imem@146bf000 restart_reason@65c) = 0x77665500, as Linux
+ *                  msm-poweroff.c writes for "reboot bootloader", then PSCI SYSTEM_RESET
+ *   "lv:reboot"    PSCI SYSTEM_RESET
+ *   "lv:poweroff"  PSCI SYSTEM_OFF
+ */
+static void
+ud_psci(uint64_t fn)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+}
+
+static bool
+ud_w_command(const char *buf, uint32_t len)
+{
+	if (len >= 11 && memcmp(buf, "lv:fastboot", 11) == 0) {
+		vm_offset_t imem = ml_io_map(0x146bf000, 0x1000);
+		printf("SWEET USB: command: restart into fastboot\n");
+		if (imem != 0) {
+			*(volatile uint32_t *)(imem + 0x65c) = 0x77665500;
+			__asm__ volatile ("dsb sy" ::: "memory");
+		}
+		delay(200000);
+		ud_psci(0x84000009);
+		return true;
+	}
+	if (len >= 9 && memcmp(buf, "lv:reboot", 9) == 0) {
+		printf("SWEET USB: command: reboot\n");
+		delay(200000);
+		ud_psci(0x84000009);
+		return true;
+	}
+	if (len >= 11 && memcmp(buf, "lv:poweroff", 11) == 0) {
+		printf("SWEET USB: command: power off\n");
+		delay(200000);
+		ud_psci(0x84000008);
+		return true;
+	}
+	return false;
+}
+
+/*
+ * lavender: touches from the PC (tools/usblog.py --cmd "tap X Y" / "swipe X1 Y1 X2 Y2 MS"), in
+ * panel pixels (1080 x 2340), fed to the HID touch service like the Novatek driver's (finger 9,
+ * out of the real fingers' way). A swipe moves in 8 ms steps from a thread of its own.
+ */
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+
+static struct {
+	int x1, y1, x2, y2, ms;
+	bool busy;
+} ud_gesture;
+
+static int
+ud_num(const char **p)
+{
+	int v = 0, any = 0;
+	while (**p == ' ') {
+		(*p)++;
+	}
+	while (**p >= '0' && **p <= '9') {
+		v = v * 10 + (**p - '0');
+		(*p)++;
+		any = 1;
+	}
+	return any ? v : -1;
+}
+
+static void
+ud_gesture_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	int steps = ud_gesture.ms / 8;
+
+	if (steps < 1) {
+		steps = 1;
+	}
+	sweet_hid_touch(9, 1, ud_gesture.x1, ud_gesture.y1);
+	for (int i = 1; i <= steps; i++) {
+		ud_sleep_ms(8);
+		sweet_hid_touch(9, 1, ud_gesture.x1 + (ud_gesture.x2 - ud_gesture.x1) * i / steps,
+		    ud_gesture.y1 + (ud_gesture.y2 - ud_gesture.y1) * i / steps);
+	}
+	ud_sleep_ms(8);
+	sweet_hid_touch(9, 0, ud_gesture.x2, ud_gesture.y2);
+	ud_gesture.busy = false;
+}
+
+static bool
+ud_w_touch_command(const char *buf, uint32_t len)
+{
+	char line[96];
+	const char *p;
+	int v[5], n = 0;
+	thread_t thread;
+
+	if (len >= sizeof(line)) {
+		return false;
+	}
+	memcpy(line, buf, len);
+	line[len] = 0;
+	if (strncmp(line, "lv:tap ", 7) == 0) {
+		p = line + 7;
+	} else if (strncmp(line, "lv:swipe ", 9) == 0) {
+		p = line + 9;
+	} else {
+		return false;
+	}
+	while (n < 5 && (v[n] = ud_num(&p)) >= 0) {
+		n++;
+	}
+	if (ud_gesture.busy || (line[3] == 't' && n < 2) || (line[3] == 's' && n < 4)) {
+		return true;
+	}
+	if (line[3] == 't') {
+		ud_gesture.x1 = ud_gesture.x2 = v[0];
+		ud_gesture.y1 = ud_gesture.y2 = v[1];
+		ud_gesture.ms = 40;
+	} else {
+		ud_gesture.x1 = v[0];
+		ud_gesture.y1 = v[1];
+		ud_gesture.x2 = v[2];
+		ud_gesture.y2 = v[3];
+		ud_gesture.ms = n >= 5 ? v[4] : 300;
+	}
+	ud_gesture.busy = true;
+	if (kernel_thread_start(ud_gesture_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		ud_gesture.busy = false;
+	}
+	return true;
+}
