+ * lavender: the PM660's PON block over SPMI, for "reboot bootloader" the way Linux does it
+ * (msm-poweroff.c + qpnp-power-on.c): restart reason BOOTLOADER in PON SOFT_RB_SPARE, PS_HOLD
+ * reset type WARM (IMEM restart_reason survives too), then PS_HOLD dropped. The TZ has PSCI
+ * 1.0 only: its SYSTEM_RESET is cold and the phone booted MIUI.
+ * SDM660 PMIC arbiter v2/v3 (DT qcom,spmi@800f000): core 0x800f000, chnls 0x8400000,
+ * obsrvr 0x9400000, cnfg 0x800a000; channel = base + 0x8000 * APID (EE 0).
+ */
+#define LV_SPMI_CORE    0x0800f000u
+#define LV_SPMI_CHNLS   0x08400000u
+#define LV_SPMI_OBSRVR  0x09400000u
+#define LV_SPMI_CNFG    0x0800a000u
+static vm_offset_t lv_spmi_core, lv_spmi_cnfg;
+
+static int
+lv_spmi_apid(unsigned ppid)
+{
+	int found = -1;
+
+	if (lv_spmi_core == 0) {
+		lv_spmi_core = ml_io_map(LV_SPMI_CORE, 0x1000);
+		lv_spmi_cnfg = ml_io_map(LV_SPMI_CNFG, 0x1000);
+	}
+	if (lv_spmi_core == 0 || lv_spmi_cnfg == 0) {
+		return -1;
+	}
+	for (unsigned i = 0; i < 512; i++) {
+		uint32_t map = *(volatile uint32_t *)(lv_spmi_core + 0x800 + 4 * i);
+		if (map == 0 || ((map >> 8) & 0xfff) != ppid) {
+			continue;
+		}
+		if (found < 0 || (*(volatile uint32_t *)(lv_spmi_cnfg + 0x700 + 4 * i) & 7) == 0) {
+			found = (int)i;
+		}
+	}
+	return found;
+}
+
+/* One byte at PMIC sid/addr: write (EXT_WRITEL on the channel) or read (EXT_READL on the observer). */
+static int
+lv_spmi_rw(bool write, unsigned sid, unsigned addr, uint8_t *val)
+{
+	int apid = lv_spmi_apid((sid << 8) | (addr >> 8));
+	if (apid < 0) {
+		return -1;
+	}
+	vm_offset_t ch = ml_io_map((write ? LV_SPMI_CHNLS : LV_SPMI_OBSRVR) + 0x8000u * (uint32_t)apid, 0x1000);
+	if (ch == 0) {
+		return -2;
+	}
+	if (write) {
+		*(volatile uint32_t *)(ch + 0x10) = *val;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	*(volatile uint32_t *)(ch + 0x0) = ((write ? 0u : 1u) << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (int i = 0; i < 1000; i++) {
+		uint32_t st = *(volatile uint32_t *)(ch + 0x8);
+		if (st & 1) {
+			if (st & 0xe) {
+				return -(int)(st & 0xe);        /* failure / denied / dropped */
+			}
+			if (!write) {
+				*val = (uint8_t)*(volatile uint32_t *)(ch + 0x18);
+			}
+			return 0;
+		}
+		delay(1);
+	}
+	return -100;
+}
+
+static void
+lv_pon_dump(const char *why)
+{
+	uint8_t spare = 0, ctl = 0, ctl2 = 0;
+	int r1 = lv_spmi_rw(false, 0, 0x88f, &spare);
+	int r2 = lv_spmi_rw(false, 0, 0x85a, &ctl);
+	int r3 = lv_spmi_rw(false, 0, 0x85b, &ctl2);
+	printf("SWEET USB: PON %s: arb 0x%08x apid(0x008) %d owner %u; SOFT_RB_SPARE 0x%02x (%d) "
+	    "PS_HOLD_RST_CTL 0x%02x (%d) CTL2 0x%02x (%d)\n", why,
+	    lv_spmi_core ? *(volatile uint32_t *)lv_spmi_core : 0, lv_spmi_apid(0x008),
+	    lv_spmi_apid(0x008) >= 0 ? (*(volatile uint32_t *)(lv_spmi_cnfg + 0x700 + 4 * (uint32_t)lv_spmi_apid(0x008)) & 7) : 9,
+	    spare, r1, ctl, r2, ctl2, r3);
+}
+
+/* Restart reason BOOTLOADER, warm PS_HOLD reset; true if every write went through. */
+static bool
+lv_pon_bootloader(void)
+{
+	uint8_t v = 0;
+	int r = lv_spmi_rw(false, 0, 0x88f, &v);
+	if (r == 0) {
+		v = (uint8_t)((v & 1) | (2u << 1));     /* PON_RESTART_REASON_BOOTLOADER (2) << 1, gen2 (1 = recovery) */
+		r = lv_spmi_rw(true, 0, 0x88f, &v);
+	}
+	if (r == 0 && lv_spmi_rw(false, 0, 0x85b, &v) == 0) {
+		v &= (uint8_t)~0x80;                    /* reset disabled while the type changes */
+		r = lv_spmi_rw(true, 0, 0x85b, &v);
+		delay(500);
+		if (r == 0 && lv_spmi_rw(false, 0, 0x85a, &v) == 0) {
+			v = (uint8_t)((v & ~0x0f) | 0x01);  /* PON_POWER_OFF_WARM_RESET */
+			r = lv_spmi_rw(true, 0, 0x85a, &v);
+		}
+		if (r == 0 && lv_spmi_rw(false, 0, 0x85b, &v) == 0) {
+			v |= 0x80;
+			r = lv_spmi_rw(true, 0, 0x85b, &v);
+		}
+		delay(500);
+	}
+	lv_pon_dump(r == 0 ? "set for fastboot" : "write FAILED");
+	return r == 0;
+}
+
+/*
+ * lavender: "lv:key power|volup|voldown|home [MS]" - a button press from the PC through the
+ * HID buttons service (SweetHID.cpp sweet_hid_key: 0 power, 1 vol+, 2 vol-, 3 home/menu),
+ * held MS ms (default 120). Wakes the display when iOS has turned it off.
+ */
+extern void sweet_hid_key(int key, int down);
+static int ud_key_code, ud_key_ms;
+static volatile bool ud_key_busy;
+
+static void
+ud_key_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	sweet_hid_key(ud_key_code, 1);
+	ud_sleep_ms((unsigned)ud_key_ms);
+	sweet_hid_key(ud_key_code, 0);
+	printf("SWEET USB: key %d pressed %d ms\n", ud_key_code, ud_key_ms);
+	ud_key_busy = false;
+}
+
+static bool
+ud_w_key_command(const char *buf, uint32_t len)
+{
+	static const char *names[] = { "power", "volup", "voldown", "home" };
+	char line[48];
+	thread_t th;
+
+	if (len < 7 || len >= sizeof(line) || memcmp(buf, "lv:key ", 7) != 0) {
+		return false;
+	}
+	memcpy(line, buf, len);
+	line[len] = 0;
+	for (int k = 0; k < 4; k++) {
+		size_t n = strlen(names[k]);
+		if (strncmp(line + 7, names[k], n) == 0 && (line[7 + n] == 0 || line[7 + n] == ' ')) {
+			int ms = 0;
+			for (const char *q = line + 7 + n; *q; q++) {
+				if (*q >= '0' && *q <= '9') {
+					ms = ms * 10 + (*q - '0');
+				}
+			}
+			if (ud_key_busy) {
+				return true;
+			}
+			ud_key_code = k;
+			ud_key_ms = ms > 0 && ms < 10000 ? ms : 120;
+			ud_key_busy = true;
+			if (kernel_thread_start(ud_key_thread, NULL, &th) == KERN_SUCCESS) {
+				thread_deallocate(th);
+			} else {
+				ud_key_busy = false;
+			}
+			return true;
+		}
+	}
+	return true;
+}
+
+/*
+ * lavender: "lv:put SIZE PATH" - the next SIZE bytes on bulk OUT are a file for PATH (at most
+ * 64 MB): the old file is unlinked first (a process that has it mapped keeps the old one), the
+ * new one written and synced from a thread of its own. tools/usblog.py --put LOCAL PATH.
+ */
+extern int unlink1(vfs_context_t ctx, vnode_t start_dvp, user_addr_t path_arg, enum uio_seg segflg, int unlink_flags);
+static char *ud_put_buf;
+static uint32_t ud_put_size, ud_put_have;
+static char ud_put_path[256];
+static volatile bool ud_put_on, ud_put_writing;
+
+static void
+ud_put_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int resid = 0, err;
+
+
+	err = unlink1(ctx, NULLVP, CAST_USER_ADDR_T(ud_put_path), UIO_SYSSPACE, 0);
+	int uerr = err;
+	err = vnode_open(ud_put_path, O_CREAT | O_TRUNC | FWRITE, 0755, 0, &vp, ctx);
+	if (err == 0) {
+		err = vn_rdwr(UIO_WRITE, vp, ud_put_buf, (int)ud_put_size, 0, UIO_SYSSPACE, IO_NOAUTH | IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (err == 0) {
+			err = VNOP_FSYNC(vp, MNT_WAIT, ctx);
+		}
+		vnode_close(vp, FWRITE, ctx);
+	}
+	printf("SWEET USB: put %s: %u bytes, unlink %d, write %d, resid %d\n", ud_put_path, ud_put_size, uerr, err, resid);
+	kfree_data(ud_put_buf, ud_put_size);
+	ud_put_buf = NULL;
+	ud_put_writing = false;
+}
+
+/* bulk OUT data while a put is on: true if it was taken */
+static bool
+ud_put_data(const char *buf, uint32_t len)
+{
+	thread_t th;
+
+	if (!ud_put_on) {
+		return false;
+	}
+	uint32_t take = len < ud_put_size - ud_put_have ? len : ud_put_size - ud_put_have;
+	memcpy(ud_put_buf + ud_put_have, buf, take);
+	ud_put_have += take;
+	if (ud_put_have >= ud_put_size) {
+		ud_put_on = false;
+		ud_put_writing = true;
+		if (kernel_thread_start(ud_put_thread, NULL, &th) == KERN_SUCCESS) {
+			thread_deallocate(th);
+		} else {
+			ud_put_writing = false;
+		}
+	}
+	return true;
+}
+
+static bool
+ud_w_put_command(const char *buf, uint32_t len)
+{
+	char line[300];
+	uint32_t size = 0, i = 7;
+
+	if (len < 9 || len >= sizeof(line) || memcmp(buf, "lv:put ", 7) != 0) {
+		return false;
+	}
+	memcpy(line, buf, len);
+	line[len] = 0;
+	while (line[i] >= '0' && line[i] <= '9') {
+		size = size * 10 + (uint32_t)(line[i++] - '0');
+	}
+	while (line[i] == ' ') {
+		i++;
+	}
+	if (ud_put_on || ud_put_writing || size == 0 || size > (64u << 20) || line[i] != '/') {
+		printf("SWEET USB: put refused (size %u, busy %d)\n", size, ud_put_on || ud_put_writing);
+		return true;
+	}
+	strlcpy(ud_put_path, line + i, sizeof(ud_put_path));
+	ud_put_buf = (char *)kalloc_data(size, Z_WAITOK);
+	if (ud_put_buf == NULL) {
+		printf("SWEET USB: put: no memory for %u bytes\n", size);
+		return true;
+	}
+	ud_put_size = size;
+	ud_put_have = 0;
+	ud_put_on = true;
+	printf("SWEET USB: put %s: waiting for %u bytes\n", ud_put_path, size);
+	return true;
+}
+
+static uint64_t
+ud_psci2(uint64_t fn, uint64_t a1, uint64_t a2)
+{
+	register uint64_t x0 __asm__("x0") = fn;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2) : : "x3", "memory");
+	return x0;
+}
+
+static void
+ud_psci(uint64_t fn)
+{
+	(void)ud_psci2(fn, 0, 0);
+}
+
+static bool
+ud_w_command(const char *buf, uint32_t len)
+{
+	if (len >= 11 && memcmp(buf, "lv:fastboot", 11) == 0) {
+		vm_offset_t imem = ml_io_map(0x146bf000, 0x1000);
+		printf("SWEET USB: command: restart into fastboot\n");
+		if (imem != 0) {
+			*(volatile uint32_t *)(imem + 0x65c) = 0x77665500;
+			__asm__ volatile ("dsb sy" ::: "memory");
+		}
+		/*
+		 * lavender: PSCI SYSTEM_RESET is a cold reset that clears IMEM, and the phone booted
+		 * MIUI. A warm reset keeps restart_reason: PSCI 1.1 SYSTEM_RESET2 (reset type 0 =
+		 * SYSTEM_WARM_RESET), if the TZ has it (PSCI_FEATURES).
+		 */
+		bool pon = lv_pon_bootloader();
+		delay(300000);                  /* (the log above goes out first) */
+		if (pon) {
+			vm_offset_t ps = ml_io_map(0x010ac000, 0x1000);     /* DT restart@10ac000 pshold-base */
+			if (ps != 0) {
+				*(volatile uint32_t *)ps = 0;               /* PS_HOLD low: the PMIC warm-resets */
+				__asm__ volatile ("dsb sy" ::: "memory");
+				delay(2000000);
+			}
+		}
+		ud_psci(0x84000009);
+		return true;
+	}
+	if (len >= 7 && memcmp(buf, "lv:shot", 7) == 0) {
+		thread_t th;
+		uint32_t sc = (len >= 9 && buf[8] >= '1' && buf[8] <= '9') ? (uint32_t)(buf[8] - '0') : 3;
+		if (!ud_shot_active) {
+			ud_shot_scale = sc;
+			ud_shot_active = true;
+			if (kernel_thread_start(ud_shot_thread, NULL, &th) == KERN_SUCCESS) {
+				thread_deallocate(th);
+			} else {
+				ud_shot_active = false;
+			}
+		}
+		return true;
+	}
+	if (ud_w_key_command(buf, len) || ud_w_put_command(buf, len)) {
+		return true;
+	}
+
+
+
+	if (len >= 9 && memcmp(buf, "lv:reboot", 9) == 0) {
+		printf("SWEET USB: command: reboot\n");
+		delay(200000);
+		ud_psci(0x84000009);
+		return true;
+	}
+	if (len >= 11 && memcmp(buf, "lv:poweroff", 11) == 0) {
+		printf("SWEET USB: command: power off\n");
+		delay(200000);
+		ud_psci(0x84000008);
+		return true;
+	}
+	return false;
+}
