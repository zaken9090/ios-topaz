+/*
+ * lavender: commands from the PC on bulk OUT 0x01 (WinUSB mode, tools/usblog.py --cmd):
+ *   "lv:fastboot"  restart into the bootloader's fastboot: IMEM restart_reason (DT
+ *                  qcom,msm-imem@146bf000 restart_reason@65c) = 0x77665500, as Linux
+ *                  msm-poweroff.c writes for "reboot bootloader", then PSCI SYSTEM_RESET
+ *   "lv:reboot"    PSCI SYSTEM_RESET
+ *   "lv:poweroff"  PSCI SYSTEM_OFF
+ */
+/*
+ * lavender: "lv:shot [N]" - the frame on the panel, every Nth pixel (default 3: 360 x 780),
+ * as RGB565 on bulk IN between "@@LVSHOT w h bytes@@" and "@@LVSHOT END@@" lines; the log
+ * waits meanwhile. tools/usblog.py turns it into dump/shot-latest.png.
+ */
+extern bool sweet_fb_shot_source(const uint8_t **va, uint32_t *stride, uint32_t *w, uint32_t *h);
+static volatile bool ud_shot_active;
+static uint32_t ud_shot_scale;
+
+static bool
+ud_w_send_wait(const char *b, uint32_t n)
+{
+	for (int i = 0; i < 3000; i++) {
+		if (ud_w_send(b, n)) {
+			return true;
+		}
+		ud_sleep_ms(1);
+	}
+	return false;
+}
+
+static void
+ud_shot_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char out[1600];
+	const uint8_t *va;
+	uint32_t stride, w, h, sc = ud_shot_scale, n = 0;
+	bool ok = true;
+
+	ud_sleep_ms(30);                /* (the log's transfer in flight ends) */
+	if (!sweet_fb_shot_source(&va, &stride, &w, &h)) {
+		ud_shot_active = false;
+		printf("SWEET USB: shot: no frame on the panel\n");
+		return;
+	}
+	uint32_t ow = w / sc, oh = h / sc;
+	n = (uint32_t)snprintf(out, sizeof(out), "\n@@LVSHOT %u %u %u@@\n", ow, oh, ow * oh * 2);
+	ok = ud_w_send_wait(out, n);
+	n = 0;
+	for (uint32_t y = 0; ok && y < oh; y++) {
+		const volatile uint32_t *row = (const volatile uint32_t *)(va + (uint64_t)y * sc * stride);
+		for (uint32_t x = 0; ok && x < ow; x++) {
+			uint32_t px = row[x * sc];      /* BGRA: B low byte */
+			uint16_t v = (uint16_t)(((px >> 8) & 0xf800) | ((px >> 5) & 0x07e0) | ((px >> 3) & 0x001f));
+			out[n++] = (char)(v & 0xff);
+			out[n++] = (char)(v >> 8);
+			if (n == 1500) {
+				ok = ud_w_send_wait(out, n);
+				n = 0;
+			}
+		}
+	}
+	if (ok && n != 0) {
+		if ((n % 512) == 0) {
+			out[n++] = 0;           /* (pad: past the byte count, the PC drops it) */
+		}
+		ok = ud_w_send_wait(out, n);
+	}
+	if (ok) {
+		n = (uint32_t)snprintf(out, sizeof(out), "\n@@LVSHOT END@@\n");
+		ok = ud_w_send_wait(out, n);
+	}
+	ud_shot_active = false;
+	printf("SWEET USB: shot %ux%u %s\n", ow, oh, ok ? "sent" : "FAILED");
+}
