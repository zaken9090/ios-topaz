+/*
+ * lavender: stop the bulk endpoints' transfers (EndTransfer, ForceRM) and forget the
+ * configuration, so the next SET_CONFIGURATION sets them up again (bus reset, disconnect:
+ * a cable plugged in again). EndTransfer is asynchronous: 100 us for it to finish before
+ * any StartTransfer, as Linux dwc3 waited.
+ */
+static void
+ud_unconfigure(void)
+{
+	if (!ud.configured || ud.lock == NULL) {
+		return;
+	}
+	lck_mtx_lock(ud.lock);
+	ud.configured = false;
+	if (ud.rx_active) {
+		ud_epcmd(EP_RX, 8 | (1u << 11), 0, 0, 0);
+	}
+	if (ud.tx_busy) {
+		ud_epcmd(EP_TX, 8 | (1u << 11), 0, 0, 0);
+	}
+	delay(100);
+	ud.rx_active = false;
+	ud.rx_rearm = false;
+	ud.tx_busy = false;
+	dwc_wr(DALEPENA, dwc_rd(DALEPENA) & ~((1u << EP_RX) | (1u << EP_TX) | (1u << EP_INT)));
+	lck_mtx_unlock(ud.lock);
+	printf("SWEET USB: unconfigured\n");
+}
