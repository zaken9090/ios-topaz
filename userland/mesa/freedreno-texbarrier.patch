+#include "main/context.h"
+#include "state_tracker/st_cb_flush.h"
+
+GLAPI void GLAPIENTRY OSMesaFlushSync(void);
+
+/*
+ * lavender: glFlush as it was before FD_TC made it asynchronous - everything handed to the driver
+ * (the threaded context's queue run to its end: the kernel has the submissions) without waiting
+ * for the GPU: the end of a frame, before the display is told of it.
+ */
+GLAPI void GLAPIENTRY
+OSMesaFlushSync(void)
+{
+   OSMesaContext osmesa = OSMesaGetCurrentContext();
+
+   if (osmesa != NULL && osmesa->st != NULL) {
+      struct gl_context *ctx = osmesa->st->ctx;
+
+      FLUSH_VERTICES(ctx, 0, 0);
+      st_glFlush(ctx, 0);
+   }
+}
