+/*
+ * lavender: drawing straight to memory (FD_MESA_DEBUG=sysmem), what was drawn is in memory once
+ * the colour cache is flushed and the texture cache invalidated - as the batch's own end does
+ * (fd5_emit_sysmem_fini) - so a texture barrier (a draw that reads the framebuffer's texture:
+ * CoreAnimation's framebuffer fetch, emulated) need not end the batch: fd_texture_barrier()
+ * flushed the whole context, a submission each time.
+ */
+static void
+fd5_texture_barrier(struct pipe_context *pctx, unsigned flags) in_dt
+{
+   struct fd_context *ctx = fd_context(pctx);
+
+   if (FD_DBG(SYSMEM)) {
+      struct fd_batch *batch = fd_context_batch(ctx);
+
+      if (!batch->nondraw && batch->draw) {
+         /* as at a batch's ends: colour cache written back, all caches flushed, then invalidated */
+         fd5_event_write(batch, batch->draw, PC_CCU_FLUSH_COLOR_TS, true);
+         OUT_WFI5(batch->draw);
+         fd5_cache_flush(batch, batch->draw);
+         fd5_event_write(batch, batch->draw, PC_CCU_INVALIDATE_COLOR, false);
+         OUT_WFI5(batch->draw);
+         fd_batch_reference(&batch, NULL);
+         return;
+      }
+      fd_batch_reference(&batch, NULL);
+   }
+   pctx->flush(pctx, NULL, 0);   /* (fd_context_flush is static in freedreno_context.c) */
+}
 
